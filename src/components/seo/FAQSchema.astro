---
/**
 * FAQSchema Component
 *
 * Generates JSON-LD structured data for FAQ sections
 * Enables rich snippet FAQ display in Google search results
 *
 * Usage:
 * <FAQSchema
 *   questions={[
 *     {
 *       question: "What is RTP?",
 *       answer: "RTP stands for Return to Player..."
 *     }
 *   ]}
 * />
 */

interface FAQItem {
	question: string;
	answer: string;
}

interface Props {
	questions: FAQItem[];
}

const { questions } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: questions.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
