---
/**
 * CasinoSchema Component
 *
 * Generates JSON-LD structured data for casino reviews
 * Implements schema.org Review and Organization types
 *
 * Usage:
 * <CasinoSchema casino={casino.data} author={author} />
 */

import type { CollectionEntry } from 'astro:content';

interface Props {
	casino: CollectionEntry<'casinos'>['data'];
	author?: CollectionEntry<'authors'>['data'];
	url?: string;
}

const { casino, author, url } = Astro.props;

// Get absolute URL
const siteUrl = Astro.site?.href || 'https://megawaysonline.com';
const reviewUrl = url || Astro.url.href;

// Build absolute image URL
const imageUrl = casino.thumbnail?.src || casino.logo?.src;
const absoluteImageUrl = imageUrl
	? imageUrl.startsWith('http')
		? imageUrl
		: new URL(imageUrl, siteUrl).href
	: new URL('/images/og-default.jpg', siteUrl).href;

// Format dates
const publishedDate = casino.publishedDate?.toISOString().split('T')[0];
const modifiedDate = casino.updatedDate?.toISOString().split('T')[0];

// Build the schema
const schema = {
	'@context': 'https://schema.org',
	'@type': 'Review',
	itemReviewed: {
		'@type': 'Organization',
		name: casino.name,
		image: absoluteImageUrl,
		...(casino.affiliateLink && { url: casino.affiliateLink }),
		...(casino.rating && {
			aggregateRating: {
				'@type': 'AggregateRating',
				ratingValue: casino.rating,
				bestRating: 5,
				worstRating: 0,
				ratingCount: 1,
			},
		}),
	},
	...(casino.rating && {
		reviewRating: {
			'@type': 'Rating',
			ratingValue: casino.rating,
			bestRating: 5,
			worstRating: 0,
		},
	}),
	...(author && {
		author: {
			'@type': 'Person',
			name: author.name,
			...(author.role && { jobTitle: author.role }),
		},
	}),
	...(publishedDate && { datePublished: publishedDate }),
	...(modifiedDate && { dateModified: modifiedDate }),
	...(reviewUrl && { url: reviewUrl }),
	publisher: {
		'@type': 'Organization',
		name: 'Megaways Online',
		url: siteUrl,
		logo: {
			'@type': 'ImageObject',
			url: new URL('/images/logo.png', siteUrl).href,
		},
	},
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
