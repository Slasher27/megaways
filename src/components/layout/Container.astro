---
interface Props {
	size?: 'sm' | 'md' | 'lg' | 'full';
	padding?: 'none' | 'sm' | 'md' | 'lg';
	class?: string;
}

const { size = 'lg', padding = 'md', class: className } = Astro.props;

const sizes = {
	sm: 'max-w-3xl',
	md: 'max-w-5xl',
	lg: 'max-w-7xl',
	full: 'max-w-full',
};

const paddings = {
	none: '',
	sm: 'py-4',
	md: 'py-8',
	lg: 'py-12',
};
---

<div class:list={[
	'mx-auto px-4 sm:px-6 lg:px-8',
	sizes[size],
	paddings[padding],
	className
]}>
	<slot />
</div>
