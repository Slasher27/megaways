---
/**
 * NavDropdown Component
 * Reusable navbar dropdown with Alpine.js for desktop navigation
 * Supports light/dark mode
 */
import type { NavLink } from '../../data/navigation';
import Link from '../ui/Link.astro';
import { Icon } from 'astro-icon/components';

interface Props {
	label: string;
	items: NavLink[];
	class?: string;
}

const { label, items, class: className } = Astro.props;
---

<div
	x-data='{
		open: false,
		toggle() {
			this.open = !this.open
		},
		close() {
			this.open = false
		}
	}'
	x-on:keydown.escape.prevent.stop='close()'
	x-on:click.outside='close()'
	class:list={['relative', className]}
>
	<!-- Dropdown Button -->
	<button
		x-on:click='toggle()'
		:aria-expanded='open'
		:aria-label="label + ' menu'"
		type='button'
		class='flex items-center gap-1 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded px-2 py-1 cursor-pointer'
	>
		<span>{label}</span>
		<Icon
			name='lucide:chevron-down'
			class='size-4 transition-transform duration-200'
			x-bind:class="open ? 'rotate-180' : ''"
		/>
	</button>

	<!-- Dropdown Panel -->
	<div
		x-show='open'
		x-transition:enter='transition ease-out duration-200'
		x-transition:enter-start='opacity-0 translate-y-1'
		x-transition:enter-end='opacity-100 translate-y-0'
		x-transition:leave='transition ease-in duration-150'
		x-transition:leave-start='opacity-100 translate-y-0'
		x-transition:leave-end='opacity-0 translate-y-1'
		x-cloak
		class='absolute left-0 mt-2 w-56 rounded-lg shadow-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 py-2 z-50'
	>
		{
			items.map((item) => (
				<Link
					href={item.href}
					underline={false}
					class='block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors'
				>
					{item.label}
				</Link>
			))
		}
	</div>
</div>
