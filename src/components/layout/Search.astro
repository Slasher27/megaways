---
/**
 * Search Component
 * Client-side search for slots and casinos using Alpine.js
 * Supports keyboard navigation (arrow keys, enter, escape)
 */
import { Icon } from 'astro-icon/components';

interface Props {
	class?: string;
	placeholder?: string;
}

const { class: className, placeholder = 'Search slots and casinos...' } = Astro.props;
---

<div
	x-data='{
		open: false,
		query: "",
		results: [],
		allData: { slots: [], casinos: [] },
		loading: false,
		dataLoaded: false,
		selectedIndex: -1,

		async init() {
			// Defer loading search data until user focuses the search input
			// This improves initial page load performance
		},

		async loadSearchData() {
			if (this.dataLoaded) return;

			this.loading = true;
			try {
				const response = await fetch("/api/search.json");
				this.allData = await response.json();
				this.dataLoaded = true;
			} catch (error) {
				console.error("Failed to load search data:", error);
			} finally {
				this.loading = false;
			}
		},

		search() {
			if (this.query.trim().length < 2) {
				this.results = [];
				this.open = false;
				this.selectedIndex = -1;
				return;
			}

			const searchTerm = this.query.toLowerCase().trim();
			const slotResults = this.allData.slots.filter(slot =>
				slot.name.toLowerCase().includes(searchTerm) ||
				slot.provider.toLowerCase().includes(searchTerm)
			).slice(0, 5);

			const casinoResults = this.allData.casinos.filter(casino =>
				casino.name.toLowerCase().includes(searchTerm)
			).slice(0, 5);

			this.results = [...slotResults, ...casinoResults];
			this.open = this.results.length > 0;
			this.selectedIndex = -1;
		},

		clear() {
			this.query = "";
			this.results = [];
			this.open = false;
			this.selectedIndex = -1;
		},

		close() {
			this.open = false;
			this.selectedIndex = -1;
		},

		selectNext() {
			if (this.results.length === 0) return;
			this.selectedIndex = (this.selectedIndex + 1) % this.results.length;
		},

		selectPrev() {
			if (this.results.length === 0) return;
			this.selectedIndex = this.selectedIndex <= 0 ? this.results.length - 1 : this.selectedIndex - 1;
		},

		goToSelected() {
			if (this.selectedIndex >= 0 && this.results[this.selectedIndex]) {
				window.location.href = this.results[this.selectedIndex].url;
			}
		},

		focusSearch() {
			this.$refs.searchInput.focus();
		}
	}'
	x-on:focus-search.window='focusSearch()'
	x-on:keydown.escape.prevent.stop='close()'
	x-on:click.outside='close()'
	class:list={['relative', className]}
>
	<!-- Search Input -->
	<div class='relative'>
		<div class='absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none'>
			<Icon name='lucide:search' class='size-5 text-gray-400' />
		</div>
		<input
			type='text'
			x-model='query'
			x-on:focus='loadSearchData()'
			x-on:input.debounce.300ms='search()'
			x-on:keydown.arrow-down.prevent='selectNext()'
			x-on:keydown.arrow-up.prevent='selectPrev()'
			x-on:keydown.enter.prevent='goToSelected()'
			placeholder={placeholder}
			class='w-full pl-10 pr-20 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400'
			autocomplete='off'
			x-ref='searchInput'
		/>
		<!-- Keyboard shortcut hint -->
		<div
			x-show='query.length === 0'
			class='absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none'
		>
			<kbd class='hidden lg:inline-block px-2 py-1 text-xs font-semibold text-gray-500 dark:text-gray-400 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded'>
				/
			</kbd>
		</div>
		<!-- Clear button -->
		<button
			x-show='query.length > 0'
			x-on:click='clear()'
			type='button'
			class='absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300'
			aria-label='Clear search'
		>
			<Icon name='lucide:x' class='size-5' />
		</button>
	</div>

	<!-- Search Results Dropdown -->
	<div
		x-show='open'
		x-transition:enter='transition ease-out duration-200'
		x-transition:enter-start='opacity-0 translate-y-1'
		x-transition:enter-end='opacity-100 translate-y-0'
		x-transition:leave='transition ease-in duration-150'
		x-transition:leave-start='opacity-100 translate-y-0'
		x-transition:leave-end='opacity-0 translate-y-1'
		x-cloak
		class='absolute left-0 right-0 mt-2 max-h-96 overflow-y-auto rounded-lg shadow-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 py-2 z-50'
	>
		<template x-if='results.length === 0 && query.length >= 2'>
			<div class='px-4 py-3 text-sm text-gray-500 dark:text-gray-400'>
				No results found for "<span x-text='query'></span>"
			</div>
		</template>

		<template x-for='(result, index) in results' :key='result.url'>
			<a
				:href='result.url'
				class='block px-4 py-3 transition-colors'
				:class='index === selectedIndex ? "bg-primary-50 dark:bg-primary-900/20" : "hover:bg-gray-100 dark:hover:bg-gray-700"'
			>
				<div class='flex items-center justify-between'>
					<div>
						<div class='font-medium text-gray-900 dark:text-white' x-text='result.name'></div>
						<div class='text-sm text-gray-500 dark:text-gray-400'>
							<span x-show='result.type === "slot"'>
								<template x-if='result.provider'>
									<span class='capitalize' x-text='result.provider.replace(/-/g, " ")'></span>
								</template>
								<span> • Slot</span>
							</span>
							<span x-show='result.type === "casino"'>Casino</span>
						</div>
					</div>
					<Icon name='lucide:arrow-right' class='size-4 text-gray-400' />
				</div>
			</a>
		</template>
	</div>
</div>
