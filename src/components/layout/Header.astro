---
import Container from './Container.astro';
import Flyout from '../interactive/alpinejs/Flyout.astro';
import Link from '../ui/Link.astro';
import NavDropdown from './NavDropdown.astro';
import NavDropdownMobile from './NavDropdownMobile.astro';
import Search from './Search.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { mainNavigation, isDropdown } from '../../data/navigation';
import logo from '../../assets/images/megaways-logo.png';

// Get current pathname for active state
const currentPath = Astro.url.pathname;

// Helper to check if a link is active
function isActive(href: string): boolean {
	// Exact match for home page
	if (href === '/' && currentPath === '/') return true;
	// For other pages, check if current path starts with href
	if (href !== '/' && currentPath.startsWith(href)) return true;
	return false;
}
---

<header class='sticky top-0 z-50 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800'>
	<Container padding='sm'>
		<div
			class='flex items-center justify-between py-3 gap-4'
			x-data='{
				open: false,
				init() {
					// Close mobile menu when resizing to desktop
					window.addEventListener("resize", () => {
						if (window.innerWidth >= 1024 && this.open) {
							this.open = false;
						}
					});
				}
			}'
		>
			<div class='flex items-center gap-8'>
				<!-- Logo -->
				<Link href='/' underline={false} class='flex items-center'>
					<Image
						src={logo}
						alt='MegawaysOnline'
						class='h-8 w-auto lg:h-10'
						loading='eager'
						quality='high'
					/>
				</Link>

				<!-- Desktop Navigation -->
				<nav class='hidden lg:flex gap-6 items-center'>
					{
						mainNavigation.map((item) =>
							isDropdown(item) ? (
								<NavDropdown label={item.label} items={item.items} />
							) : (
								<Link
									href={item.href}
									variant='muted'
									underline={false}
									class={isActive(item.href)
										? 'font-semibold text-primary-600 dark:text-primary-400'
										: ''
									}
								>
									{item.label}
								</Link>
							)
						)
					}
				</nav>
			</div>

			<!-- Desktop Search -->
			<div class='hidden lg:block flex-1 max-w-xs'>
				<Search />
			</div>

			<!-- Mobile Menu Button -->
			<button
				@click='open = true'
				class='lg:hidden p-3 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
				aria-label='Open menu'
			>
				<Icon name='lucide:menu' class='size-7' />
			</button>

			<!-- Mobile Menu Flyout -->
			<Flyout direction='right' maxWidth='xs' showCloseButton={false}>
				<!-- Header Slot -->
				<div slot='header' class='flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800'>
					<span class='text-lg font-bold text-gray-900 dark:text-white'>Menu</span>
					<button
						type='button'
						@click='$dialog.close()'
						class='p-3 text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800'
						aria-label='Close menu'
					>
						<Icon name='lucide:x' class='size-7' />
					</button>
				</div>

				<!-- Mobile Search -->
				<div class='p-4 border-b border-gray-200 dark:border-gray-800'>
					<Search placeholder='Search...' />
				</div>

				<!-- Mobile Navigation -->
				<nav class='flex flex-col p-4'>
					<!-- Main Navigation Section -->
					<div class='mb-4'>
						<h3 class='px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider'>
							Main Menu
						</h3>
						<div class='flex flex-col space-y-1'>
							{
								mainNavigation
									.filter((item) => !isDropdown(item))
									.map((item) => (
										<a
											href={item.href}
											@click='$dialog.close()'
											class={`block px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors ${
												isActive(item.href)
													? 'font-semibold bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400'
													: 'text-gray-700 dark:text-gray-300'
											}`}
										>
											{item.label}
										</a>
									))
							}
						</div>
					</div>

					<!-- Divider -->
					<div class='border-t border-gray-200 dark:border-gray-700 my-2'></div>

					<!-- Categories Section -->
					<div>
						<h3 class='px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider'>
							Categories
						</h3>
						<div class='space-y-1'>
							{
								mainNavigation
									.filter((item) => isDropdown(item))
									.map((item) => (
										<NavDropdownMobile label={item.label} items={item.items} />
									))
							}
						</div>
					</div>
				</nav>
			</Flyout>
		</div>
	</Container>
</header>
