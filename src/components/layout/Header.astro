---
import Container from './Container.astro';
import Link from '../ui/Link.astro';
import NavDropdown from './NavDropdown.astro';
import NavDropdownMobile from './NavDropdownMobile.astro';
import Search from './Search.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { mainNavigation, isDropdown, type NavLink } from '../../data/navigation';
import logo from '../../assets/images/megaways-logo.png';

// Get current pathname for active state
const currentPath = Astro.url.pathname;

// Helper to check if a link is active
function isActive(href: string): boolean {
	// Exact match for home page
	if (href === '/' && currentPath === '/') return true;
	// For other pages, check if current path starts with href
	if (href !== '/' && currentPath.startsWith(href)) return true;
	return false;
}
---

<header class='sticky top-0 z-50 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800'>
	<Container padding='none'>
		<div class='flex items-center justify-between py-3 gap-4'>
			<div class='flex items-center gap-8'>
				<!-- Logo -->
				<Link href='/' underline={false} class='flex items-center'>
					<Image
						src={logo}
						alt='MegawaysOnline'
						class='h-8 w-auto lg:h-10'
						loading='eager'
						quality='high'
					/>
				</Link>

				<!-- Desktop Navigation -->
				<nav class='hidden lg:flex gap-6 items-center'>
					{
						mainNavigation.map((item) =>
							isDropdown(item) ? (
								<NavDropdown label={item.label} items={item.items} />
							) : (
								<Link
									href={(item as NavLink).href}
									variant='muted'
									underline={false}
									class={isActive((item as NavLink).href)
										? 'font-semibold text-primary-700 dark:text-primary-400'
										: ''
									}
								>
									{item.label}
								</Link>
							)
						)
					}
				</nav>
			</div>

			<!-- Desktop Search -->
			<div class='hidden lg:block flex-1 max-w-xs'>
				<Search />
			</div>

			<!-- Mobile Menu Button -->
			<button
				id='mobile-menu-open'
				type='button'
				class='lg:hidden p-2.5 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
				aria-label='Open menu'
				aria-haspopup='dialog'
			>
				<Icon name='lucide:menu' class='size-6' />
			</button>

			<!-- Mobile Menu (native dialog: focus trap, Esc close and backdrop for free) -->
			<dialog
				id='mobile-menu'
				aria-label='Mobile menu'
				class='mobile-menu bg-white dark:bg-gray-900 text-inherit shadow-xl w-full max-w-xs overflow-y-auto'
			>
				<!-- Menu Header -->
				<div class='flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800'>
					<span class='text-lg font-bold text-gray-900 dark:text-white'>Menu</span>
					<button
						id='mobile-menu-close'
						type='button'
						class='p-3 text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800'
						aria-label='Close menu'
					>
						<Icon name='lucide:x' class='size-7' />
					</button>
				</div>

				<!-- Mobile Search -->
				<div class='p-4 border-b border-gray-200 dark:border-gray-800'>
					<Search placeholder='Search...' />
				</div>

				<!-- Mobile Navigation -->
				<nav class='flex flex-col p-4' aria-label='Mobile navigation'>
					<!-- Main Navigation Section -->
					<div class='mb-4'>
						<div class='px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider' role='heading' aria-level='2'>
							Main Menu
						</div>
						<div class='flex flex-col space-y-1'>
							{
								mainNavigation
									.filter((item) => !isDropdown(item))
									.map((item) => (
										<a
											href={(item as NavLink).href}
											class={`block px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors ${
												isActive((item as NavLink).href)
													? 'font-semibold bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-400'
													: 'text-gray-700 dark:text-gray-300'
											}`}
										>
											{item.label}
										</a>
									))
							}
						</div>
					</div>

					<!-- Divider -->
					<div class='border-t border-gray-200 dark:border-gray-700 my-2'></div>

					<!-- Categories Section -->
					<div>
						<div class='px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider' role='heading' aria-level='2'>
							Categories
						</div>
						<div class='space-y-1'>
							{
								mainNavigation
									.filter((item) => isDropdown(item))
									.map((item) => (
										<NavDropdownMobile label={item.label} items={item.items} />
									))
							}
						</div>
					</div>
				</nav>
			</dialog>
		</div>
	</Container>
</header>

<style>
	/* Right-hand drawer: override the UA's centered-dialog defaults. */
	.mobile-menu {
		position: fixed;
		inset: 0 0 0 auto;
		margin: 0;
		height: 100dvh;
		max-height: none;
		border: none;
		padding: 0;
		/* Slide + fade, including on close (allow-discrete keeps it rendered
		   while the exit transition runs). */
		translate: 100% 0;
		transition:
			translate 300ms ease-in,
			display 300ms allow-discrete,
			overlay 300ms allow-discrete;
	}

	.mobile-menu[open] {
		translate: 0 0;
		transition-timing-function: ease-out;
	}

	/* Entry start state (element has just switched to display:block). */
	@starting-style {
		.mobile-menu[open] {
			translate: 100% 0;
		}
	}

	.mobile-menu::backdrop {
		background-color: rgb(0 0 0 / 0.5);
		transition:
			background-color 300ms,
			display 300ms allow-discrete,
			overlay 300ms allow-discrete;
	}

	:global(.dark) .mobile-menu::backdrop {
		background-color: rgb(0 0 0 / 0.7);
	}

	@starting-style {
		.mobile-menu[open]::backdrop {
			background-color: rgb(0 0 0 / 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu,
		.mobile-menu::backdrop {
			transition: none;
		}
	}
</style>

<script>
	const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;

	document
		.getElementById('mobile-menu-open')
		?.addEventListener('click', () => menu?.showModal());
	document
		.getElementById('mobile-menu-close')
		?.addEventListener('click', () => menu?.close());

	// Light dismiss: a click that lands on the <dialog> itself is on the backdrop.
	menu?.addEventListener('click', (e) => {
		if (e.target === menu) menu.close();
	});

	// Close if the viewport is resized up to the desktop layout.
	window
		.matchMedia('(min-width: 64rem)')
		.addEventListener('change', (m) => {
			if (m.matches) menu?.close();
		});
</script>
