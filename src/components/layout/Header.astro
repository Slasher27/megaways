---
import Container from './Container.astro';
import Flyout from '../interactive/alpinejs/Flyout.astro';
import Link from '../ui/Link.astro';
import NavDropdown from './NavDropdown.astro';
import NavDropdownMobile from './NavDropdownMobile.astro';
import { Icon } from 'astro-icon/components';
import { mainNavigation, isDropdown } from '../../data/navigation';
---

<header class='border-b border-gray-200 dark:border-gray-800'>
	<Container padding='sm'>
		<div
			class='flex items-center justify-between py-3'
			x-data='{ open: false }'
		>
			<div class='flex items-center gap-8'>
				<!-- Logo -->
				<Link href='/' underline={false} class='text-xl font-bold'>
					MegawaysOnline
				</Link>

				<!-- Desktop Navigation -->
				<nav class='hidden lg:flex gap-6 items-center'>
					{
						mainNavigation.map((item) =>
							isDropdown(item) ? (
								<NavDropdown label={item.label} items={item.items} />
							) : (
								<Link href={item.href} variant='muted' underline={false}>
									{item.label}
								</Link>
							)
						)
					}
				</nav>
			</div>

			<!-- Mobile Menu Button -->
			<button
				@click='open = true'
				class='lg:hidden p-3 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
				aria-label='Open menu'
			>
				<Icon name='lucide:menu' class='size-7' />
			</button>

			<!-- Mobile Menu Flyout -->
			<Flyout direction='right' maxWidth='xs' showCloseButton={false}>
				<!-- Header Slot -->
				<div slot='header' class='flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800'>
					<span class='text-lg font-bold text-gray-900 dark:text-white'>Menu</span>
					<button
						type='button'
						@click='$dialog.close()'
						class='p-3 text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800'
						aria-label='Close menu'
					>
						<Icon name='lucide:x' class='size-7' />
					</button>
				</div>

				<!-- Mobile Navigation -->
				<nav class='flex flex-col p-4 space-y-1'>
					{
						mainNavigation.map((item) =>
							isDropdown(item) ? (
								<NavDropdownMobile label={item.label} items={item.items} />
							) : (
								<Link
									href={item.href}
									underline={false}
									class='px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg'
								>
									{item.label}
								</Link>
							)
						)
					}
				</nav>
			</Flyout>
		</div>
	</Container>
</header>
