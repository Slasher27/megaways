---
/**
 * Reusable Flyout Component
 * A slide-in panel that appears from the left or right side of the screen with an overlay.
 * Uses Alpine.js Dialog plugin for accessibility and proper focus management.
 */

interface Props {
	/** Direction the flyout slides in from */
	direction?: 'left' | 'right';
	/** Maximum width of the flyout panel */
	maxWidth?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'full';
	/** Z-index for the flyout (useful for stacking) */
	zIndex?: string;
	/** Background color class for the panel */
	panelBg?: string;
	/** Whether to show a close button in the panel */
	showCloseButton?: boolean;
	/** Additional classes for the panel */
	class?: string;
}

const {
	direction = 'right',
	maxWidth = 'sm',
	zIndex = 'z-50',
	panelBg = 'bg-white dark:bg-gray-900',
	showCloseButton = true,
	class: className,
} = Astro.props;

const maxWidths = {
	xs: 'max-w-xs',
	sm: 'max-w-sm',
	md: 'max-w-md',
	lg: 'max-w-lg',
	xl: 'max-w-xl',
	full: 'max-w-full',
};

const positions = {
	left: 'left-0',
	right: 'right-0',
};

const transitions = {
	left: {
		start: '-translate-x-full',
		end: 'translate-x-0',
	},
	right: {
		start: 'translate-x-full',
		end: 'translate-x-0',
	},
};

import { Icon } from 'astro-icon/components';
---

<!-- Flyout Container -->
<div
	x-dialog
	x-model='open'
	x-cloak
	class:list={['fixed inset-0 overflow-hidden', zIndex]}
>
	<!-- Overlay -->
	<div
		x-dialog:overlay
		x-transition.opacity
		class='fixed inset-0 bg-black/50 dark:bg-black/70'
	>
	</div>

	<!-- Panel -->
	<div class:list={['fixed inset-y-0', positions[direction], maxWidths[maxWidth], 'w-full']}>
		<div
			x-dialog:panel
			x-transition:enter='transition ease-out duration-300'
			x-transition:enter-start={transitions[direction].start}
			x-transition:enter-end={transitions[direction].end}
			x-transition:leave='transition ease-in duration-300'
			x-transition:leave-start={transitions[direction].end}
			x-transition:leave-end={transitions[direction].start}
			class='h-full w-full'
		>
			<div class:list={['h-full flex flex-col shadow-xl overflow-y-auto', panelBg, className]}>
				<!-- Optional Close Button (Absolute positioned in top-right) -->
				{showCloseButton && (
					<div class='absolute right-0 top-0 p-4'>
						<button
							type='button'
							@click='$dialog.close()'
							class='p-3 text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800'
							aria-label='Close panel'
						>
							<Icon name='lucide:x' class='size-6' />
						</button>
					</div>
				)}

				<!-- Header Slot (Optional) -->
				<slot name='header' />

				<!-- Body Slot (Main Content) -->
				<div class='flex-1'>
					<slot />
				</div>

				<!-- Footer Slot (Optional) -->
				<slot name='footer' />
			</div>
		</div>
	</div>
</div>
