---
/**
 * BackToTop Button Component
 *
 * Floating button that appears when user scrolls down past a threshold.
 * Uses Alpine.js for scroll detection and smooth scroll to top.
 *
 * Features:
 * - Shows after scrolling 300px down
 * - Smooth scroll animation
 * - Fixed position in bottom-right corner
 * - Fade in/out animation
 * - Accessible with ARIA labels
 * - Dark mode support
 */

interface Props {
	/** Scroll threshold in pixels before button appears (default: 300) */
	scrollThreshold?: number;
	/** Position from bottom in rem (default: 4) */
	bottom?: number;
	/** Position from right in rem (default: 4) */
	right?: number;
	/** Additional CSS classes */
	class?: string;
}

const {
	scrollThreshold = 300,
	bottom = 4,
	right = 4,
	class: className = ''
} = Astro.props;
---

<div
	x-data={`{
		show: false,
		scrollThreshold: ${scrollThreshold},
		init() {
			// Check scroll position on init
			this.show = window.pageYOffset > this.scrollThreshold;

			// Listen for scroll events
			window.addEventListener('scroll', () => {
				this.show = window.pageYOffset > this.scrollThreshold;
			});
		},
		scrollToTop() {
			window.scrollTo({
				top: 0,
				behavior: 'smooth'
			});
		}
	}`}
	x-show="show"
	x-transition:enter="transition ease-out duration-300"
	x-transition:enter-start="opacity-0 translate-y-4"
	x-transition:enter-end="opacity-100 translate-y-0"
	x-transition:leave="transition ease-in duration-200"
	x-transition:leave-start="opacity-100 translate-y-0"
	x-transition:leave-end="opacity-0 translate-y-4"
	class={`fixed z-50 ${className}`}
	style={`bottom: ${bottom}rem; right: ${right}rem;`}
>
	<button
		@click="scrollToTop()"
		type="button"
		aria-label="Back to top"
		class="group flex items-center justify-center w-12 h-12 rounded-full bg-primary-600 hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600 text-white shadow-lg hover:shadow-xl transition-all duration-200 ring-0 hover:ring-2 ring-primary-300 dark:ring-primary-400 ring-offset-0 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="24"
			height="24"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="transition-colors duration-200"
			aria-hidden="true"
		>
			<path d="m18 15-6-6-6 6"></path>
		</svg>
		<span class="sr-only">Scroll to top of page</span>
	</button>
</div>
