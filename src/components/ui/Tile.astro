---
/**
 * Tile — icon + title + data chip + description, for TileGrid inside review
 * MDX. Brand logos come from simple-icons (e.g. `simple-icons:bitcoin`),
 * concepts from lucide. `meta` is the headline fact ("0–2 hrs", "No fees").
 */
import { Icon } from 'astro-icon/components';

interface Props {
	icon?: string;
	title: string;
	meta?: string;
	class?: string;
}

const { icon, title, meta, class: className = '' } = Astro.props;
---

<div
	class:list={[
		'rounded-2xl bg-gray-100 dark:bg-gray-800/60 p-4 flex items-start gap-3',
		className,
	]}
>
	{
		icon && (
			<span
				class='inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-white dark:bg-gray-900 text-primary-700 dark:text-primary-400 shadow-sm'
				aria-hidden='true'
			>
				<Icon name={icon} class='size-5' />
			</span>
		)
	}
	<div class='min-w-0'>
		<p class='flex flex-wrap items-baseline gap-x-2 gap-y-0.5 mb-0.5'>
			<span class='font-display font-semibold text-gray-900 dark:text-white'>
				{title}
			</span>
			{
				meta && (
					<span class='text-[0.6875rem] font-bold uppercase tracking-wider text-primary-700 dark:text-primary-400'>
						{meta}
					</span>
				)
			}
		</p>
		<div class='text-sm text-gray-600 dark:text-gray-400 leading-relaxed'>
			<slot />
		</div>
	</div>
</div>
