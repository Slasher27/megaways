---
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
	name: string;
	size?: number | string;
	class?: string;
	title?: string;
	style?: string;
	[key: string]: any;
}

const { name, size = 24, class: className = '', title, style, ...rest } = Astro.props;

// Convert size to appropriate format
const sizeValue = typeof size === 'number' ? `${size}px` : size;

// A11y: icons are DECORATIVE by default — they sit beside text that already
// carries the meaning, so exposing them to a screen reader is noise. Passing a
// `title` opts the icon in as a meaningful graphic instead (role=img + name).
const a11yAttrs = title
	? { role: 'img' }
	: { 'aria-hidden': 'true', focusable: 'false' };
---

<AstroIcon
	name={name}
	width={sizeValue}
	height={sizeValue}
	class:list={['inline-block', className]}
	title={title}
	style={style}
	{...a11yAttrs}
	{...rest}
/>
