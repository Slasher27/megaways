---
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
	name: string;
	size?: number | string;
	class?: string;
	title?: string;
	style?: string;
}

const { name, size = 24, class: className = '', title, style } = Astro.props;

// Convert size to appropriate format
const sizeValue = typeof size === 'number' ? `${size}px` : size;
---

<AstroIcon
	name={name}
	width={sizeValue}
	height={sizeValue}
	class:list={['inline-block', className]}
	title={title}
	style={style}
/>
