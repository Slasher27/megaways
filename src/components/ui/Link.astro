---
interface Props {
	href: string;
	external?: boolean;
	variant?: 'default' | 'primary' | 'muted';
	underline?: boolean;
	class?: string;
}

const {
	href,
	external = false,
	variant = 'default',
	underline = true,
	class: className = '',
} = Astro.props;

const variants = {
	default:
		'text-gray-900 dark:text-gray-100 hover:text-primary-600 dark:hover:text-primary-400',
	primary: 'text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300',
	muted:
		'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100',
} as const;

const underlineClass = underline ? 'underline' : '';

// External link attributes
const externalAttrs = external
	? { target: '_blank', rel: 'noopener noreferrer' }
	: {};
---

<a
	href={href}
	class:list={['transition-colors', variants[variant], underlineClass, className]}
	{...externalAttrs}
>
	<slot />
</a>
