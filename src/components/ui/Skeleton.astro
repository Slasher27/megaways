---
interface Props {
	variant?: 'text' | 'circular' | 'rectangular';
	width?: string;
	height?: string;
	class?: string;
}

const {
	variant = 'text',
	width,
	height,
	class: className = '',
} = Astro.props;

const variants = {
	text: 'h-4 rounded',
	circular: 'rounded-full',
	rectangular: 'rounded-lg',
} as const;

const widthClass = width ? '' : 'w-full';
const heightClass = height ? '' : variant === 'circular' ? 'aspect-square' : '';

const inlineStyles = {
	...(width && { width }),
	...(height && { height }),
};
---

<div
	class:list={[
		'animate-pulse bg-gray-200 dark:bg-gray-700',
		variants[variant],
		widthClass,
		heightClass,
		className,
	]}
	style={inlineStyles}
/>
