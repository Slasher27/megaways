---
interface Props {
	/** Element to render — lets semantic wrappers (section, details, links) reuse the surface. */
	as?: 'div' | 'section' | 'article' | 'details' | 'a';
	/** Link target when as='a'. */
	href?: string;
	variant?: 'default' | 'outlined' | 'elevated' | 'slot' | 'casino' | 'bonus';
	padding?: 'none' | 'sm' | 'md' | 'lg';
	hover?: boolean;
	class?: string;
}

const {
	as: Tag = 'div',
	href,
	variant = 'default',
	padding = 'md',
	hover = false,
	class: className = '',
}: Props = Astro.props;

// Surface language: raised cards separate from the canvas by background +
// shadow, never borders. `outlined` remains for the rare case a border is
// genuinely the right tool.
const raised = 'bg-white dark:bg-gray-900 shadow-sm';

const variants = {
	default: raised,
	slot: raised,
	casino: raised,
	bonus: raised,
	elevated: 'bg-white dark:bg-gray-900 shadow-lg',
	outlined: 'bg-transparent border border-gray-200 dark:border-gray-800',
} as const;

const paddings = {
	none: '',
	sm: 'p-4',
	md: 'p-6',
	lg: 'p-8',
} as const;

const hoverClasses = hover
	? variant === 'slot' || variant === 'casino'
		? 'transition-shadow duration-200 hover:shadow-lg'
		: 'transition-all duration-200 hover:shadow-lg hover:scale-[1.02] cursor-pointer'
	: '';
---

<Tag
	href={href}
	class:list={[
		'rounded-2xl',
		variants[variant],
		paddings[padding],
		hoverClasses,
		className,
	]}
>
	<slot />
</Tag>
