---
/**
 * StatGrid — label/value tiles (owner design handoff 2026-10-27):
 *   sunken — inner tiles inside a card (slot stats beside the demo, bonus terms)
 *   raised — tiles on the canvas (casino quick facts)
 * Items with an empty value are dropped, so callers pass every fact they
 * know about and the grid shows only what the data actually has.
 */
import Icon from './Icon.astro';
import Card from './Card.astro';

interface Item {
	label: string;
	/** Falsy-but-not-zero values (undefined, null, '', false) are dropped. */
	value?: string | number | null | false;
	icon?: string;
	/** Extra classes for the value (e.g. a volatility colour). */
	tone?: string;
}

interface Props {
	items: Item[];
	surface?: 'sunken' | 'raised';
	/** 'auto' = as many ≥170px columns as fit (the design's quick-facts row). */
	cols?: 2 | 3 | 4 | 'auto';
	/** Show at most this many (after empty values are dropped). */
	limit?: number;
	class?: string;
}

const { items, surface = 'sunken', cols = 4, limit, class: className = '' } = Astro.props;

const shown = items.filter((i) => i.value || i.value === 0).slice(0, limit);
const raised = surface === 'raised';

const colClasses = {
	2: 'grid-cols-2',
	3: 'grid-cols-3',
	4: 'grid-cols-2 sm:grid-cols-4',
	auto: 'grid-cols-[repeat(auto-fit,minmax(min(100%,170px),1fr))]',
} as const;
---

{
	shown.length > 0 && (
		<dl class:list={['grid m-0', raised ? 'gap-3' : 'gap-2', colClasses[cols], className]}>
			{shown.map((item) => (
				<Card
					variant={raised ? 'tile' : 'sunken'}
					padding='none'
					class:list={['min-w-0 flex flex-col gap-1', raised ? 'px-5 py-4 justify-center' : 'px-3.5 py-3']}
				>
					<dt class='flex items-center gap-1.5 text-xs font-semibold text-gray-600 dark:text-gray-400'>
						{item.icon && <Icon name={item.icon} size={13} class='text-primary-700 dark:text-primary-400 shrink-0' />}
						{item.label}
					</dt>
					<dd class:list={['font-bold text-gray-900 dark:text-gray-100 leading-snug m-0 wrap-break-word', raised ? 'text-[1.0625rem]' : 'text-lg', item.tone]}>
						{item.value}
					</dd>
				</Card>
			))}
		</dl>
	)
}
