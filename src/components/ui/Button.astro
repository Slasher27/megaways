---
interface Props {
	variant?: 'primary' | 'secondary' | 'ghost' | 'danger' | 'dark';
	size?: 'sm' | 'md' | 'lg';
	href?: string;
	external?: boolean;
	affiliate?: boolean;
	/** Label left, trailing icon right (the design's full-width CTAs). */
	spread?: boolean;
	disabled?: boolean;
	class?: string;
	/** Any extra attributes (aria-describedby, id, data-*) forwarded to the element */
	[key: string]: any;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	external = false,
	affiliate = false,
	spread = false,
	disabled = false,
	class: className,
	...rest
} = Astro.props;

const baseStyles =
	'inline-flex items-center gap-3 font-semibold rounded-full transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none';

const variants = {
	// Design accent with DARK text: #171412 on #f26b1d = 6.0:1 (WCAG AA).
	primary: 'bg-primary-500 text-gray-950 hover:bg-primary-400 focus:ring-primary-500',
	// Dark pill on an accent surface (the verdict card).
	dark: 'bg-gray-950 text-gray-100 hover:bg-gray-800 focus:ring-gray-950',
	secondary:
		'bg-gray-100 text-gray-900 hover:bg-gray-200 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700 focus:ring-gray-500',
	ghost:
		'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-gray-200 dark:hover:bg-gray-800 focus:ring-gray-500',
	danger: 'bg-red-600 text-white hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600 focus:ring-red-500',
};

const sizes = {
	sm: 'px-3 py-1.5 text-sm',
	md: 'px-4 py-2 text-base',
	lg: 'px-6 py-3 text-lg',
};

const Tag = href ? 'a' : 'button';

// Build link attributes
const linkAttrs: Record<string, any> = {};
if (href) {
	linkAttrs.href = href;
}

// External links
if (external) {
	linkAttrs.target = '_blank';
	linkAttrs.rel = 'noopener noreferrer';
}

// Affiliate links (locked policy, CLAUDE.md rule 8)
if (affiliate) {
	linkAttrs.target = '_blank';
	linkAttrs.rel = 'sponsored nofollow noopener';
	linkAttrs.referrerpolicy = 'no-referrer';
}

// Disabled state
if (disabled && !href) {
	linkAttrs.disabled = true;
}
---

<Tag
	class:list={[baseStyles, spread ? 'justify-between' : 'justify-center', variants[variant], sizes[size], className]}
	{...linkAttrs}
	{...rest}
>
	<slot />
	{
		/* A11y: links that jump to a new tab must say so — sighted users get the
		   context from the surrounding copy, screen-reader users get nothing. */
		linkAttrs.target === '_blank' && <span class='sr-only'>(opens in a new tab)</span>
	}
</Tag>
