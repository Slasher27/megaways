---
interface Props {
	variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
	size?: 'sm' | 'md' | 'lg';
	href?: string;
	external?: boolean;
	affiliate?: boolean;
	disabled?: boolean;
	class?: string;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	external = false,
	affiliate = false,
	disabled = false,
	class: className,
} = Astro.props;

const baseStyles =
	'inline-flex items-center justify-center font-semibold rounded-lg transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none';

const variants = {
	primary: 'bg-primary-600 text-white hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600 focus:ring-primary-500',
	secondary:
		'bg-gray-100 text-gray-900 hover:bg-gray-200 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700 focus:ring-gray-500',
	ghost:
		'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-gray-200 dark:hover:bg-gray-800 focus:ring-gray-500',
	danger: 'bg-red-600 text-white hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600 focus:ring-red-500',
};

const sizes = {
	sm: 'px-3 py-1.5 text-sm',
	md: 'px-4 py-2 text-base',
	lg: 'px-6 py-3 text-lg',
};

const Tag = href ? 'a' : 'button';

// Build link attributes
const linkAttrs: Record<string, any> = {};
if (href) {
	linkAttrs.href = href;
}

// External links
if (external) {
	linkAttrs.target = '_blank';
	linkAttrs.rel = 'noopener noreferrer';
}

// Affiliate links (according to CLAUDE.md)
if (affiliate) {
	linkAttrs.target = '_blank';
	linkAttrs.rel = 'noopener noreferrer nofollow';
}

// Disabled state
if (disabled && !href) {
	linkAttrs.disabled = true;
}
---

<Tag
	class:list={[baseStyles, variants[variant], sizes[size], className]}
	{...linkAttrs}
>
	<slot />
</Tag>
