---
interface Props {
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'sm' | 'md' | 'lg';
	href?: string;
	external?: boolean;
	class?: string;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	external = false,
	class: className,
} = Astro.props;

const baseStyles =
	'inline-flex items-center justify-center font-semibold rounded-lg transition-colors';
const variants = {
	primary: 'bg-blue-600 text-white hover:bg-blue-700',
	secondary:
		'bg-gray-100 text-gray-900 hover:bg-gray-200 dark:bg-gray-800 dark:text-white',
	ghost:
		'text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400',
};
const sizes = {
	sm: 'px-3 py-1.5 text-sm',
	md: 'px-4 py-2 text-base',
	lg: 'px-6 py-3 text-lg',
};

const Tag = href ? 'a' : 'button';
const externalAttrs = external
	? { target: '_blank', rel: 'noopener noreferrer' }
	: {};
---

<!-- Button.astro -->
<Tag
	href={href}
	class:list={[baseStyles, variants[variant], sizes[size], className]}
	{...externalAttrs}
>
	<slot />
</Tag>
