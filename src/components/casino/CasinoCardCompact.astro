---
/**
 * CasinoCardCompact Component
 * Compact casino card for sidebars and smaller spaces
 * Simplified version with essential info only
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';

interface Props {
	casinoEntry: CollectionEntry<'casinos'>;
	class?: string;
}

const { casinoEntry, class: className } = Astro.props;
const casino = casinoEntry.data;

// Generate casino URL
const casinoUrl = `/online-casinos/${casino.slug}-casino-review/`;
---

<Card variant='default' padding='sm' hover={true} class:list={['group', className]}>
	<div class='flex items-start gap-3'>
		<!-- Casino Logo -->
		<div class='flex-shrink-0'>
			{
				casino.logo ? (
					<Image
						src={casino.logo}
						alt={casino.name}
						width={80}
						height={30}
						class='h-8 w-auto object-contain'
						loading='lazy'
					/>
				) : (
					<div class='h-8 flex items-center'>
						<span class='text-sm font-bold text-gray-900 dark:text-white'>{casino.name}</span>
					</div>
				)
			}
		</div>

		<!-- Content -->
		<div class='flex-1 min-w-0'>
			<!-- Rating & Badges -->
			<div class='flex items-center gap-2 mb-2'>
				{
					casino.rating && (
						<div class='flex items-center gap-1'>
							<Icon name='lucide:star' size={14} class='text-yellow-500 fill-yellow-500' />
							<span class='text-sm font-semibold text-gray-900 dark:text-white'>
								{casino.rating.toFixed(1)}
							</span>
						</div>
					)
				}
				{casino.featured && <Badge variant='warning' size='sm'>Featured</Badge>}
				{casino.isNew && <Badge variant='success' size='sm'>New</Badge>}
			</div>

			<!-- Bonus -->
			{
				casino.welcomeBonus && (
					<div class='mb-3'>
						<p class='text-xs font-semibold text-green-700 dark:text-green-400 mb-0.5'>
							{casino.welcomeBonus.title}
						</p>
						<p class='text-xs text-gray-700 dark:text-gray-300 font-medium'>
							{casino.welcomeBonus.amount}
						</p>
					</div>
				)
			}

			<!-- Quick Stats -->
			<div class='flex flex-wrap gap-2 mb-3 text-xs text-gray-600 dark:text-gray-400'>
				{casino.hasMegaways && (
					<span class='flex items-center gap-1'>
						<Icon name='lucide:zap' size={12} class='text-primary-600 dark:text-primary-400' />
						Megaways
					</span>
				)}
				{casino.cryptoAccepted && (
					<span class='flex items-center gap-1'>
						<Icon name='lucide:coins' size={12} class='text-orange-600 dark:text-orange-400' />
						Crypto
					</span>
				)}
			</div>

			<!-- CTA -->
			<Button href={casino.affiliateLink} variant='primary' size='sm' affiliate={true} class='w-full'>
				Play Now
			</Button>
		</div>
	</div>

	<!-- Review Link -->
	<a
		href={casinoUrl}
		class='block text-center text-xs text-gray-500 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 mt-2 pt-2 border-t border-gray-200 dark:border-gray-700 transition-colors'
	>
		Read Review →
	</a>
</Card>
