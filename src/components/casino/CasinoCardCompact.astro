---
/**
 * CasinoCardCompact — a small link card to OUR review (never an affiliate
 * CTA: alternatives are the two-hop model, and they'd blow the 3-CTA budget).
 * Used for the "alternatives" list at the end of every casino review.
 */
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';
import { casinoScore } from '../../data/scorecards';

interface Props {
	casinoEntry: CollectionEntry<'casinos'>;
	class?: string;
}

const { casinoEntry, class: className } = Astro.props;
const casino = casinoEntry.data;
const { score, max } = casinoScore(casino);
---

<Card
	as='a'
	href={`/online-casinos/${casino.slug}-casino-review/`}
	padding='sm'
	hover={true}
	class:list={['group flex items-center gap-3 min-w-0', className]}
>
	<span
		class='grid place-items-center size-11 shrink-0 rounded-xl bg-primary-700 dark:bg-primary-500 text-white dark:text-gray-950 font-display text-lg font-bold'
		aria-hidden='true'
	>
		{casino.name.charAt(0)}
	</span>
	<span class='min-w-0 flex-1'>
		<span class='flex items-baseline gap-2'>
			<span class='font-display font-semibold text-gray-900 dark:text-white truncate group-hover:text-primary-700 dark:group-hover:text-primary-400'>
				{casino.name}
			</span>
			{score !== undefined && (
				<span class='text-sm font-bold text-primary-700 dark:text-primary-400 shrink-0'>
					{score}<span class='font-normal text-gray-600 dark:text-gray-400'>/{max}</span>
				</span>
			)}
		</span>
		<span class='block text-sm text-gray-600 dark:text-gray-400 truncate'>
			{casino.megawaysCount ? `${casino.megawaysCount} Megaways slots` : casino.welcomeBonus?.amount}
		</span>
	</span>
</Card>
