---
/**
 * PaymentCards — banking rows (owner design 2026-10-27, §3.8): method ·
 * "Min · Max" · payout pill. The pill is green only for a withdrawal WE
 * timed (`tested`); operator figures stay neutral and say so (law 5).
 * MDX: <PaymentCards rows={frontmatter.payments} />
 */
import { paymentMethodMeta } from '../../data/payment-methods';
import { fmtDate, eur } from '../../data/format';

interface Row {
	method: string;
	min?: number;
	max?: number;
	fee?: string;
	depositTime?: string;
	withdrawalTime?: string;
	tested?: { time: string; date: Date | string };
}

interface Props {
	rows?: Row[];
	class?: string;
}

const { rows = [], class: className = '' } = Astro.props;
---

{
	rows.length > 0 && (
		<div class:list={['not-prose', className]}>
		<ul class='flex flex-col gap-1.5 m-0 p-0 list-none'>
			{rows.map((row) => {
				const limits = [row.min !== undefined && `Min ${eur(row.min)}`, row.max !== undefined && `Max ${eur(row.max)}`, row.fee && `Fee ${row.fee}`]
					.filter(Boolean)
					.join(' · ');
				const time = row.tested ? `${row.tested.time} · tested ${fmtDate(row.tested.date)}` : row.withdrawalTime;
				return (
					<li class='rounded-[14px] bg-gray-100 dark:bg-gray-800 px-4 py-3.5 grid grid-cols-[minmax(0,1fr)_auto] md:grid-cols-[180px_minmax(0,1fr)_auto] gap-x-4 gap-y-1 items-center text-[0.9375rem]'>
						<span class='font-bold text-gray-900 dark:text-gray-100'>{paymentMethodMeta(row.method).label}</span>
						<span class='text-sm text-gray-600 dark:text-gray-400 row-start-2 md:row-start-auto'>
							{limits}
							{row.depositTime && <>{limits && ' · '}Deposit {row.depositTime}</>}
						</span>
						{time && (
							<span
								class:list={[
									'justify-self-end row-start-1 col-start-2 md:col-start-3 px-2.5 py-1 rounded-full text-[0.8125rem] font-bold text-right',
									row.tested
										? 'bg-green-100 text-green-800 dark:bg-pos-bg dark:text-pos-text'
										: 'bg-gray-200 text-gray-700 dark:bg-ink-line dark:text-gray-300',
								]}
								title={row.tested ? 'Timed by us' : 'Operator-reported, not yet tested by us'}
							>
								{time}
								{!row.tested && <span class='sr-only'> (operator-reported, not yet tested by us)</span>}
							</span>
						)}
					</li>
				);
			})}
		</ul>
		{rows.some((r) => !r.tested && r.withdrawalTime) && (
			<p class='text-xs text-gray-600 dark:text-gray-400 mt-2.5 mb-0'>
				Grey times are operator-reported, not yet tested by us; green = timed by us.
			</p>
		)}
		</div>
	)
}
