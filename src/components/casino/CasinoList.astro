---
/**
 * CasinoList Component
 *
 * Filterable and sortable list of casinos
 * Uses Alpine.js for client-side filtering
 *
 * Usage:
 * <CasinoList casinos={casinoEntries} />
 */

import type { CollectionEntry } from 'astro:content';
import CasinoCard from './CasinoCard.astro';
import Badge from '../ui/Badge.astro';
import H3 from '../typography/H3.astro';

interface Props {
	casinos: CollectionEntry<'casinos'>[];
	showFilters?: boolean;
	class?: string;
}

const { casinos, showFilters = true, class: className } = Astro.props;

// Extract unique markets and providers for filters
const allMarkets = [...new Set(casinos.flatMap((c) => c.data.markets || []))];
const allProviders = [...new Set(casinos.flatMap((c) => c.data.providers || []))];

// Sort options
const sortOptions = [
	{ value: 'rating-desc', label: 'Highest Rated' },
	{ value: 'rating-asc', label: 'Lowest Rated' },
	{ value: 'name-asc', label: 'Name (A-Z)' },
	{ value: 'name-desc', label: 'Name (Z-A)' },
	{ value: 'newest', label: 'Newest First' },
];
---

<div class:list={['casino-list', className]} x-data={`{
	casinos: ${JSON.stringify(
		casinos.map((c) => ({
			id: c.id,
			slug: c.data.slug,
			name: c.data.name,
			rating: c.data.rating || 0,
			markets: c.data.markets || [],
			providers: c.data.providers || [],
			hasMegaways: c.data.hasMegaways || false,
			cryptoAccepted: c.data.cryptoAccepted || false,
			featured: c.data.featured || false,
			isNew: c.data.isNew || false,
			publishedDate: c.data.publishedDate?.toISOString() || '',
		}))
	)},
	filteredCasinos: [],
	selectedMarket: 'all',
	selectedProvider: 'all',
	showMegawaysOnly: false,
	showCryptoOnly: false,
	sortBy: 'rating-desc',

	init() {
		this.filterAndSort();
	},

	filterAndSort() {
		let filtered = this.casinos;

		// Apply market filter
		if (this.selectedMarket !== 'all') {
			filtered = filtered.filter(c => c.markets.includes(this.selectedMarket));
		}

		// Apply provider filter
		if (this.selectedProvider !== 'all') {
			filtered = filtered.filter(c => c.providers.includes(this.selectedProvider));
		}

		// Apply Megaways filter
		if (this.showMegawaysOnly) {
			filtered = filtered.filter(c => c.hasMegaways);
		}

		// Apply Crypto filter
		if (this.showCryptoOnly) {
			filtered = filtered.filter(c => c.cryptoAccepted);
		}

		// Sort
		filtered = [...filtered].sort((a, b) => {
			switch (this.sortBy) {
				case 'rating-desc':
					return (b.rating || 0) - (a.rating || 0);
				case 'rating-asc':
					return (a.rating || 0) - (b.rating || 0);
				case 'name-asc':
					return a.name.localeCompare(b.name);
				case 'name-desc':
					return b.name.localeCompare(a.name);
				case 'newest':
					return new Date(b.publishedDate) - new Date(a.publishedDate);
				default:
					return 0;
			}
		});

		this.filteredCasinos = filtered;
	},

	clearFilters() {
		this.selectedMarket = 'all';
		this.selectedProvider = 'all';
		this.showMegawaysOnly = false;
		this.showCryptoOnly = false;
		this.filterAndSort();
	}
}`}>
	{
		showFilters && (
			<div class='mb-8 p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl'>
				<H3 size='md' class='mb-4'>
					Filter Casinos
				</H3>

				<div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4'>
					<!-- Market Filter -->
					<div>
						<label class='block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'>
							Market
						</label>
						<select
							x-model='selectedMarket'
							@change='filterAndSort()'
							class='w-full px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500'
						>
							<option value='all'>All Markets</option>
							{allMarkets.map((market) => (
								<option value={market}>{market}</option>
							))}
						</select>
					</div>

					<!-- Provider Filter -->
					<div>
						<label class='block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'>
							Provider
						</label>
						<select
							x-model='selectedProvider'
							@change='filterAndSort()'
							class='w-full px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500'
						>
							<option value='all'>All Providers</option>
							{allProviders.map((provider) => (
								<option value={provider}>{provider.replace(/-/g, ' ')}</option>
							))}
						</select>
					</div>

					<!-- Sort By -->
					<div>
						<label class='block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'>
							Sort By
						</label>
						<select
							x-model='sortBy'
							@change='filterAndSort()'
							class='w-full px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500'
						>
							{sortOptions.map((option) => (
								<option value={option.value}>{option.label}</option>
							))}
						</select>
					</div>

					<!-- Quick Filters -->
					<div>
						<label class='block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'>
							Quick Filters
						</label>
						<div class='space-y-2'>
							<label class='flex items-center'>
								<input
									type='checkbox'
									x-model='showMegawaysOnly'
									@change='filterAndSort()'
									class='w-4 h-4 text-primary-600 bg-white dark:bg-gray-900 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500'
								/>
								<span class='ml-2 text-sm text-gray-700 dark:text-gray-300'>Megaways Only</span>
							</label>
							<label class='flex items-center'>
								<input
									type='checkbox'
									x-model='showCryptoOnly'
									@change='filterAndSort()'
									class='w-4 h-4 text-primary-600 bg-white dark:bg-gray-900 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500'
								/>
								<span class='ml-2 text-sm text-gray-700 dark:text-gray-300'>Crypto Only</span>
							</label>
						</div>
					</div>
				</div>

				<!-- Clear Filters Button -->
				<button
					@click='clearFilters()'
					class='text-sm text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium'
				>
					Clear all filters
				</button>

				<!-- Results Count -->
				<p class='mt-4 text-sm text-gray-600 dark:text-gray-400'>
					Showing <span x-text='filteredCasinos.length' class='font-semibold' /> of{' '}
					<span class='font-semibold'>{casinos.length}</span> casinos
				</p>
			</div>
		)
	}

	<!-- Casino Grid -->
	<div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6'>
		{
			casinos.map((casino) => (
				<div x-show={`filteredCasinos.some(c => c.slug === '${casino.data.slug}')`} x-transition>
					<CasinoCard casinoEntry={casino} />
				</div>
			))
		}
	</div>

	<!-- No Results Message -->
	<div
		x-show='filteredCasinos.length === 0'
		x-transition
		class='text-center py-12 text-gray-500 dark:text-gray-400'
	>
		<p class='text-lg font-medium mb-2'>No casinos found</p>
		<p class='text-sm'>Try adjusting your filters</p>
	</div>
</div>
