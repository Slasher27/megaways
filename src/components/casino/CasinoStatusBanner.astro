---
/**
 * CasinoStatusBanner — status honesty (CASINO-REVIEW-PROTOCOL law 6).
 * Renders a prominent banner on warning/closed reviews; nothing for live.
 * The closed state links the /online-casinos/closed/ archive. statusNote is
 * the one-line, evidence-cited explanation from frontmatter.
 */
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
	casino: CollectionEntry<'casinos'>['data'];
	class?: string;
}

const { casino, class: className = '' } = Astro.props;
const { status, statusNote, closedDate, name } = casino;

const closedFormatted = closedDate?.toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

{
	status === 'closed' && (
		<div
			class:list={[
				'rounded-2xl bg-red-50 dark:bg-red-950/40 p-5 flex gap-3',
				className,
			]}
			role='alert'
		>
			<Icon
				name='lucide:octagon-x'
				size={24}
				class='text-red-700 dark:text-red-400 shrink-0'
				aria-hidden='true'
			/>
			<div class='text-sm text-red-900 dark:text-red-200'>
				<p class='font-display font-bold mb-1'>
					{name} has closed{closedFormatted && ` (${closedFormatted})`} — do
					not attempt to deposit.
				</p>
				{statusNote && <p class='mb-1'>{statusNote}</p>}
				<p class='mb-0'>
					This review is kept as a record.{' '}
					<a href='/online-casinos/closed/' class='underline font-medium'>
						See all closed casinos we've reviewed
					</a>{' '}
					or{' '}
					<a href='/online-casinos/' class='underline font-medium'>
						browse live Megaways casinos
					</a>
					.
				</p>
			</div>
		</div>
	)
}

{
	status === 'warning' && (
		<div
			class:list={[
				'rounded-2xl bg-amber-50 dark:bg-amber-950/40 p-5 flex gap-3',
				className,
			]}
			role='alert'
		>
			<Icon
				name='lucide:triangle-alert'
				size={24}
				class='text-amber-700 dark:text-amber-400 shrink-0'
				aria-hidden='true'
			/>
			<div class='text-sm text-amber-900 dark:text-amber-200'>
				<p class='font-display font-bold mb-1'>
					Caution advised at {name}.
				</p>
				<p class='mb-0'>
					{statusNote ??
						'Recent changes at this casino warrant extra care — read the trust section before depositing.'}
				</p>
			</div>
		</div>
	)
}
