---
/**
 * TocList — numbered "On this page" link list for review articles.
 *
 * The numbering intentionally matches the section counters rendered on
 * `.review-prose > h2` (global.css), so the TOC and the article agree.
 * Wrappers differ per context (sticky aside on xl, <details> card below),
 * so this component renders only the list itself.
 *
 * Scrollspy: the section currently being read carries
 * `aria-current="location"` (set by the script below; styled in CSS).
 * JS justification (CLAUDE.md rule 5): CSS has no scroll-position selector —
 * this is a ~20-line rAF-throttled handler, no library, no Alpine.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
	class?: string;
}

const { headings, class: className = '' } = Astro.props;
---

<ol class:list={['toc-list flex flex-col gap-0.5 m-0 p-0 list-none', className]}>
	{
		headings.map((heading, index) => (
			<li>
				<a
					href={`#${heading.slug}`}
					class='grid grid-cols-[30px_minmax(0,1fr)] px-2.5 py-2.5 rounded-[10px] leading-snug text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors aria-[current=location]:bg-gray-100 aria-[current=location]:text-gray-900 dark:aria-[current=location]:bg-ink-hover dark:aria-[current=location]:text-gray-100'
				>
					<span class='toc-num text-xs font-bold text-primary-700 dark:text-primary-500 tabular-nums pt-0.5'>
						{String(index + 1).padStart(2, '0')}
					</span>
					<span class='min-w-0'>{heading.text}</span>
				</a>
			</li>
		))
	}
</ol>

<script>
	// Scrollspy: mark the last heading scrolled past the 120px reading line.
	// Astro dedupes this script even though TocList renders twice per page.
	const links = [
		...document.querySelectorAll<HTMLAnchorElement>('.toc-list a[href^="#"]'),
	];
	const targets = [
		...new Set(links.map((a) => a.getAttribute('href')!.slice(1))),
	]
		.map((id) => document.getElementById(id))
		.filter((el): el is HTMLElement => el !== null);

	// The sticky section bar (ReviewShell, below xl) mirrors the active entry.
	const bar = document.querySelector<HTMLDetailsElement>('.toc-bar');
	const barNum = bar?.querySelector('.toc-bar-num');
	const barLabel = bar?.querySelector('.toc-bar-label');
	bar?.addEventListener('click', (e) => {
		if ((e.target as Element).closest('a')) bar.open = false;
	});

	if (links.length && targets.length) {
		let ticking = false;
		const update = () => {
			ticking = false;
			// Reading line sits below the header (+ the sticky bar when shown).
			const line = bar && bar.offsetParent !== null ? 160 : 120;
			let current: string | null = null;
			for (const el of targets) {
				if (el.getBoundingClientRect().top <= line) current = el.id;
				else break; // targets are in document order
			}
			let active: HTMLAnchorElement | undefined;
			for (const a of links) {
				if (current && a.getAttribute('href') === `#${current}`) {
					a.setAttribute('aria-current', 'location');
					active ??= a;
				} else a.removeAttribute('aria-current');
			}
			if (active && barNum && barLabel) {
				barNum.textContent = active.querySelector('.toc-num')?.textContent ?? '';
				barLabel.textContent = active.lastElementChild?.textContent ?? '';
			}
		};
		addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		update();
	}
</script>
