---
/**
 * AuthorCard Component
 *
 * Displays author information for E-E-A-T (Experience, Expertise, Authoritativeness, Trustworthiness)
 * Shows author photo, name, role, bio, and publication dates
 */

import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Card from '../ui/Card.astro';
import Image from '../ui/Image.astro';

interface Props {
	author: CollectionEntry<'authors'>;
	publishedDate?: Date;
	updatedDate?: Date;
	variant?: 'compact' | 'full';
	class?: string;
}

const {
	author,
	publishedDate,
	updatedDate,
	variant = 'compact',
	class: className = '',
} = Astro.props;

// Format dates (en-GB — the site's register, matches SessionLog/VerifiedChip)
const formatDate = (date: Date | undefined) => {
	if (!date) return null;
	return date.toLocaleDateString('en-GB', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
};

const publishedFormatted = formatDate(publishedDate);
const updatedFormatted = formatDate(updatedDate);
---

<Card class={className}>
	<div class="flex items-start gap-4">
		<!-- Author Avatar -->
		{author.data.avatar && (
			<div class="flex-shrink-0">
				<Image
					src={author.data.avatar}
					alt={author.data.name}
					width={variant === 'full' ? 96 : 64}
					height={variant === 'full' ? 96 : 64}
					class="rounded-full"
					loading="lazy"
				/>
			</div>
		)}

		<!-- Author Info -->
		<div class="flex-1 min-w-0">
			<!-- Name & Role -->
			<div class="mb-3">
				<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">
					<a
						href="/about/team/"
						class="hover:text-primary-700 dark:hover:text-primary-400"
					>
						{author.data.name}
					</a>
				</h3>
				{author.data.role && (
					<p class="text-sm font-medium text-primary-700 dark:text-primary-400">
						{author.data.role}
					</p>
				)}
			</div>

			<!-- Bio -->
			{variant === 'full' && author.data.bio && (
				<p class="text-sm text-gray-700 dark:text-gray-300 mb-4 leading-relaxed">
					{author.data.bio}
				</p>
			)}
			{variant === 'compact' && author.data.shortBio && (
				<p class="text-sm text-gray-700 dark:text-gray-300 mb-4 leading-relaxed">
					{author.data.shortBio}
				</p>
			)}

			<!-- Expertise Tags -->
			{variant === 'full' && author.data.expertise && author.data.expertise.length > 0 && (
				<div class="mb-4">
					<p class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-2">
						Expertise
					</p>
					<div class="flex flex-wrap gap-2">
						{author.data.expertise.map((skill) => (
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-xs font-medium rounded-full">
								{skill}
							</span>
						))}
					</div>
				</div>
			)}

			<!-- Years Experience -->
			{author.data.yearsExperience && (
				<div class="flex items-center gap-2 mb-4">
					<Icon name="lucide:award" size={16} class="text-primary-600 dark:text-primary-400" />
					<span class="text-sm text-gray-700 dark:text-gray-300">
						{author.data.yearsExperience}+ years of experience
					</span>
				</div>
			)}

			<!-- Publication Dates -->
			<div class="flex flex-wrap items-center gap-4 text-xs text-gray-600 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800 pt-3 mt-3">
				{publishedFormatted && (
					<div class="flex items-center gap-1.5">
						<Icon name="lucide:calendar" size={14} class="text-gray-500 dark:text-gray-500" />
						<span>Published: <time datetime={publishedDate?.toISOString()}>{publishedFormatted}</time></span>
					</div>
				)}
				{updatedFormatted && (
					<div class="flex items-center gap-1.5">
						<Icon name="lucide:refresh-cw" size={14} class="text-gray-500 dark:text-gray-500" />
						<span>Updated: <time datetime={updatedDate?.toISOString()}>{updatedFormatted}</time></span>
					</div>
				)}
			</div>

			<!-- Social Links -->
			{variant === 'full' && author.data.socials && (
				<div class="flex gap-3 mt-4">
					{author.data.socials.linkedin && (
						<a
							href={author.data.socials.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="p-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg transition-colors"
							aria-label="LinkedIn profile"
						>
							<Icon name="lucide:linkedin" size={18} class="text-gray-600 dark:text-gray-400" />
						</a>
					)}
					{author.data.socials.twitter && (
						<a
							href={author.data.socials.twitter}
							target="_blank"
							rel="noopener noreferrer"
							class="p-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg transition-colors"
							aria-label="Twitter profile"
						>
							<Icon name="lucide:twitter" size={18} class="text-gray-600 dark:text-gray-400" />
						</a>
					)}
				</div>
			)}
		</div>
	</div>
</Card>
