---
/**
 * ProsCons Component
 *
 * Displays pros and cons in a visually appealing two-column layout
 */

import { Icon } from 'astro-icon/components';
import Card from '../ui/Card.astro';

interface Props {
	pros?: string[];
	cons?: string[];
	class?: string;
}

const { pros = [], cons = [], class: className = '' } = Astro.props;
---

{(pros.length > 0 || cons.length > 0) && (
	<div class={`grid md:grid-cols-2 gap-6 ${className}`}>
		<!-- Pros -->
		{pros.length > 0 && (
			<Card>
				<div class="flex items-center gap-3 mb-4">
					<div class="p-2 bg-green-100 dark:bg-green-900/40 rounded-lg">
						<Icon name="lucide:thumbs-up" size={22} class="text-green-700 dark:text-green-400" />
					</div>
					<h2 class="text-lg md:text-xl font-bold mb-0 text-gray-900 dark:text-white">
						Pros
					</h2>
				</div>
				<ul class="space-y-3">
					{pros.map((pro) => (
						<li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
							<Icon name="lucide:check-circle-2" size={20} class="text-green-600 dark:text-green-400 flex-shrink-0 mt-0.5" />
							<span class="leading-relaxed">{pro}</span>
						</li>
					))}
				</ul>
			</Card>
		)}

		<!-- Cons -->
		{cons.length > 0 && (
			<Card>
				<div class="flex items-center gap-3 mb-4">
					<div class="p-2 bg-red-100 dark:bg-red-900/40 rounded-lg">
						<Icon name="lucide:thumbs-down" size={22} class="text-red-700 dark:text-red-400" />
					</div>
					<h2 class="text-lg md:text-xl font-bold mb-0 text-gray-900 dark:text-white">
						Cons
					</h2>
				</div>
				<ul class="space-y-3">
					{cons.map((con) => (
						<li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
							<Icon name="lucide:x-circle" size={20} class="text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5" />
							<span class="leading-relaxed">{con}</span>
						</li>
					))}
				</ul>
			</Card>
		)}
	</div>
)}
