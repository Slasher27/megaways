---
/**
 * ProsCons Component
 *
 * Displays pros and cons in a visually appealing two-column layout
 */

import { Icon } from 'astro-icon/components';
import H3 from '../typography/H3.astro';

interface Props {
	pros?: string[];
	cons?: string[];
	class?: string;
}

const { pros = [], cons = [], class: className = '' } = Astro.props;
---

{(pros.length > 0 || cons.length > 0) && (
	<div class={`grid md:grid-cols-2 gap-6 ${className}`}>
		<!-- Pros -->
		{pros.length > 0 && (
			<div class="bg-linear-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-xl p-6 border border-green-200 dark:border-green-800">
				<div class="flex items-center gap-3 mb-4">
					<div class="p-2 bg-green-100 dark:bg-green-800/50 rounded-lg">
						<Icon name="lucide:thumbs-up" size={24} class="text-green-600 dark:text-green-400" />
					</div>
					<H3 size="sm" class="mb-0! text-green-800 dark:text-green-300">
						Pros
					</H3>
				</div>
				<ul class="space-y-3">
					{pros.map((pro) => (
						<li class="flex items-start gap-3 text-gray-800 dark:text-gray-200">
							<Icon name="lucide:check-circle-2" size={20} class="text-green-600 dark:text-green-400 flex-shrink-0 mt-0.5" />
							<span class="leading-relaxed">{pro}</span>
						</li>
					))}
				</ul>
			</div>
		)}

		<!-- Cons -->
		{cons.length > 0 && (
			<div class="bg-linear-to-br from-red-50 to-rose-50 dark:from-red-900/20 dark:to-rose-900/20 rounded-xl p-6 border border-red-200 dark:border-red-800">
				<div class="flex items-center gap-3 mb-4">
					<div class="p-2 bg-red-100 dark:bg-red-800/50 rounded-lg">
						<Icon name="lucide:thumbs-down" size={24} class="text-red-600 dark:text-red-400" />
					</div>
					<H3 size="sm" class="mb-0! text-red-800 dark:text-red-300">
						Cons
					</H3>
				</div>
				<ul class="space-y-3">
					{cons.map((con) => (
						<li class="flex items-start gap-3 text-gray-800 dark:text-gray-200">
							<Icon name="lucide:x-circle" size={20} class="text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5" />
							<span class="leading-relaxed">{con}</span>
						</li>
					))}
				</ul>
			</div>
		)}
	</div>
)}
