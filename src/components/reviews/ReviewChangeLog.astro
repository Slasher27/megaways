---
/**
 * ReviewChangeLog — dated, honest record of material review changes
 * (REVIEW-PROTOCOL law 5): a changelog entry is, alongside a session entry,
 * the only legitimate updatedDate trigger. Renders nothing without entries.
 * Rendered route-level (after the author card) from `changelog` frontmatter.
 */
import { Icon } from 'astro-icon/components';
import Card from '../ui/Card.astro';

interface Props {
	entries?: { date: Date; change: string }[];
	class?: string;
}

const { entries = [], class: className = '' } = Astro.props;

const sorted = [...entries].sort((a, b) => b.date.getTime() - a.date.getTime());
const fmtDate = (d: Date) =>
	d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

{
	sorted.length > 0 && (
		<Card as='section' class={className}>
			<h3 class='flex items-center gap-2 font-display text-lg font-bold text-gray-900 dark:text-white mb-4'>
				<Icon
					name='lucide:history'
					size={18}
					class='text-primary-700 dark:text-primary-400'
					aria-hidden='true'
				/>
				Review History
			</h3>
			<ol class='space-y-3 list-none p-0 m-0'>
				{sorted.map((entry) => (
					<li class='grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm'>
						<time
							datetime={entry.date.toISOString().slice(0, 10)}
							class='font-display font-semibold text-gray-900 dark:text-white whitespace-nowrap'
						>
							{fmtDate(entry.date)}
						</time>
						<span class='text-gray-700 dark:text-gray-300'>
							{entry.change}
						</span>
					</li>
				))}
			</ol>
		</Card>
	)
}
