---
/**
 * WhereToPlay Component
 *
 * Displays recommended casinos where users can play the slot
 * Includes CTA buttons with affiliate links
 */

import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import H2 from '../typography/H2.astro';
import P from '../typography/P.astro';

interface Casino {
	name: string;
	logo?: string;
	bonus?: string;
	rating?: number;
	affiliateLink: string;
	reviewUrl?: string;
	featured?: boolean;
}

interface Props {
	slotName: string;
	casinos?: Casino[];
	/** Suppress the internal header when the MDX supplies its own H2
	 *  (protocol reviews use a question-format, TOC-visible heading). */
	hideHeader?: boolean;
	class?: string;
}

const {
	slotName,
	casinos = [],
	hideHeader = false,
	class: className = '',
} = Astro.props;

// Default: the top-rated featured casinos from the collection (real data,
// real affiliate links) — never hardcoded placeholders.
let displayCasinos = casinos;
if (displayCasinos.length === 0) {
	// Only live casinos are ever recommended (protocol law 6: no closed or
	// warning-status casino appears in an automatic recommendation slot).
	const featured = await getCollection('casinos', (entry) =>
		Boolean(
			entry.data.featured &&
				entry.data.affiliateLink &&
				(entry.data.status ?? 'live') === 'live',
		),
	);
	displayCasinos = featured
		.sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))
		.slice(0, 2)
		.map((entry, index) => ({
			name: entry.data.name,
			bonus: entry.data.welcomeBonus?.amount,
			rating: entry.data.rating,
			affiliateLink: entry.data.affiliateLink ?? '',
			reviewUrl: `/online-casinos/${entry.data.slug}-casino-review/`,
			featured: index === 0,
		}));
}
---

<Card as='section' padding='none' class={`p-6 sm:p-8 ${className}`}>
	{
		!hideHeader && (
			<div class='text-center mb-8'>
				<p class='text-[0.6875rem] font-bold uppercase tracking-wider text-primary-700 dark:text-primary-400 mb-2'>
					Ready to spin?
				</p>
				<H2 size='md' class='mb-3!'>
					Where to Play {slotName}
				</H2>
				<P class='text-gray-600 dark:text-gray-400'>
					Play {slotName} at these top-rated online casinos
				</P>
			</div>
		)
	}

	<div class="grid md:grid-cols-2 gap-4">
		{displayCasinos.map((casino) => (
			<div class="rounded-xl bg-gray-100 dark:bg-gray-800/60 p-6">
				{/* Featured Badge */}
				{casino.featured && (
					<div class="mb-3">
						<Badge variant="warning" size="sm">
							<Icon name="lucide:star" size={14} class="inline mr-1" />
							Featured
						</Badge>
					</div>
				)}

				{/* Casino Logo/Name */}
				<div class="mb-4">
					{casino.logo ? (
						<img
							src={casino.logo}
							alt={casino.name}
							class="h-12 object-contain"
						/>
					) : (
						<h3 class="text-xl font-bold text-gray-900 dark:text-white">
							{casino.name}
						</h3>
					)}
				</div>

				{/* Rating */}
				{casino.rating && (
					<div class="flex items-center gap-2 mb-3">
						<div class="flex items-center">
							{Array.from({ length: 5 }).map((_, i) => (
								<Icon
									name="lucide:star"
									size={16}
									class={i < Math.floor(casino.rating!) ? 'text-yellow-500 fill-yellow-500' : 'text-gray-300 dark:text-gray-600'}
								/>
							))}
						</div>
						<span class="text-sm font-semibold text-gray-700 dark:text-gray-300">
							{casino.rating}/5
						</span>
					</div>
				)}

				{/* Bonus */}
				{casino.bonus && (
					<div class="mb-4 p-3 bg-white dark:bg-gray-900/70 rounded-lg">
						<div class="flex items-start gap-2">
							<Icon name="lucide:gift" size={18} class="text-green-600 dark:text-green-400 flex-shrink-0 mt-0.5" />
							<div>
								<p class="text-xs font-semibold text-green-800 dark:text-green-300 uppercase tracking-wide mb-1">
									Welcome Bonus
								</p>
								<p class="text-sm font-bold text-green-900 dark:text-green-200">
									{casino.bonus}
								</p>
							</div>
						</div>
					</div>
				)}

				{/* CTA Button */}
				<Button
					href={casino.affiliateLink}
					variant="primary"
					size="lg"
					affiliate={true}
					class="w-full justify-center"
				>
					Play Now
					<Icon name="lucide:arrow-right" size={18} class="ml-2" />
				</Button>

				{/* Internal review link */}
				{casino.reviewUrl && (
					<p class="text-center mt-3 mb-0">
						<a
							href={casino.reviewUrl}
							class="text-sm font-medium text-primary-700 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300"
						>
							Read our {casino.name} review &rarr;
						</a>
					</p>
				)}

				{/* Disclaimer */}
				<p class="text-xs text-gray-600 dark:text-gray-400 text-center mt-3">
					18+. T&Cs apply. Gamble responsibly.
				</p>
			</div>
		))}
	</div>

	{/* Responsible Gambling Notice */}
	<div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-800">
		<div class="flex items-start gap-3 text-sm text-gray-600 dark:text-gray-400">
			<Icon name="lucide:shield-alert" size={20} class="flex-shrink-0 mt-0.5 text-primary-700 dark:text-primary-400" />
			<p>
				This review contains affiliate links. We may receive a commission if you sign up through our links, at no extra cost to you.
				All casinos are licensed and regulated. Please gamble responsibly.
			</p>
		</div>
	</div>
</Card>
