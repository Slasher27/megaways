---
/**
 * SlotList Component
 *
 * Filterable and sortable list of slots
 * Uses Alpine.js for client-side filtering
 *
 * Usage:
 * <SlotList slots={slotEntries} />
 */

import type { CollectionEntry } from 'astro:content';
import SlotCard from './SlotCard.astro';
import H3 from '../typography/H3.astro';

interface Props {
	slots: CollectionEntry<'slots'>[];
	showFilters?: boolean;
	class?: string;
}

const { slots, showFilters = true, class: className } = Astro.props;

// Extract unique values for filters
const allProviders = [...new Set(slots.map((s) => s.data.provider).filter(Boolean))];
const allVolatilities = [...new Set(slots.map((s) => s.data.volatility).filter(Boolean))];
const allMechanics = [...new Set(slots.flatMap((s) => s.data.mechanics || []))];

// Sort options
const sortOptions = [
	{ value: 'rating-desc', label: 'Highest Rated' },
	{ value: 'rating-asc', label: 'Lowest Rated' },
	{ value: 'rtp-desc', label: 'Highest RTP' },
	{ value: 'rtp-asc', label: 'Lowest RTP' },
	{ value: 'name-asc', label: 'Name (A-Z)' },
	{ value: 'name-desc', label: 'Name (Z-A)' },
	{ value: 'newest', label: 'Newest First' },
];
---

<div class:list={['slot-list', className]} x-data={`{
	slots: ${JSON.stringify(
		slots.map((s) => ({
			id: s.id,
			slug: s.data.slug,
			name: s.data.name,
			provider: s.data.provider || '',
			rating: s.data.rating || 0,
			rtp: s.data.rtp || 0,
			volatility: s.data.volatility || '',
			mechanics: s.data.mechanics || [],
			bonusBuy: s.data.bonusBuy || false,
			publishedDate: s.data.publishedDate?.toISOString() || '',
		}))
	)},
	filteredSlots: [],
	selectedProvider: 'all',
	selectedVolatility: 'all',
	selectedMechanic: 'all',
	showBonusBuyOnly: false,
	sortBy: 'rating-desc',

	init() {
		this.filterAndSort();
	},

	filterAndSort() {
		let filtered = this.slots;

		// Apply provider filter
		if (this.selectedProvider !== 'all') {
			filtered = filtered.filter(s => s.provider === this.selectedProvider);
		}

		// Apply volatility filter
		if (this.selectedVolatility !== 'all') {
			filtered = filtered.filter(s => s.volatility === this.selectedVolatility);
		}

		// Apply mechanic filter
		if (this.selectedMechanic !== 'all') {
			filtered = filtered.filter(s => s.mechanics.includes(this.selectedMechanic));
		}

		// Apply bonus buy filter
		if (this.showBonusBuyOnly) {
			filtered = filtered.filter(s => s.bonusBuy);
		}

		// Sort
		filtered = [...filtered].sort((a, b) => {
			switch (this.sortBy) {
				case 'rating-desc':
					return (b.rating || 0) - (a.rating || 0);
				case 'rating-asc':
					return (a.rating || 0) - (b.rating || 0);
				case 'rtp-desc':
					return (b.rtp || 0) - (a.rtp || 0);
				case 'rtp-asc':
					return (a.rtp || 0) - (b.rtp || 0);
				case 'name-asc':
					return a.name.localeCompare(b.name);
				case 'name-desc':
					return b.name.localeCompare(a.name);
				case 'newest':
					return new Date(b.publishedDate) - new Date(a.publishedDate);
				default:
					return 0;
			}
		});

		this.filteredSlots = filtered;
	},

	clearFilters() {
		this.selectedProvider = 'all';
		this.selectedVolatility = 'all';
		this.selectedMechanic = 'all';
		this.showBonusBuyOnly = false;
		this.filterAndSort();
	}
}`}>
	{
		showFilters && (
			<div class='mb-8 p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl'>
				<H3 size='md' class='mb-4'>
					Filter Slots
				</H3>

				<div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4'>
					<!-- Provider Filter -->
					<div>
						<label class='block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'>
							Provider
						</label>
						<select
							x-model='selectedProvider'
							@change='filterAndSort()'
							class='w-full px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500'
						>
							<option value='all'>All Providers</option>
							{allProviders.map((provider) => (
								<option value={provider}>{provider.toUpperCase()}</option>
							))}
						</select>
					</div>

					<!-- Volatility Filter -->
					<div>
						<label class='block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'>
							Volatility
						</label>
						<select
							x-model='selectedVolatility'
							@change='filterAndSort()'
							class='w-full px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500'
						>
							<option value='all'>All Volatilities</option>
							{allVolatilities.map((vol) => (
								<option value={vol}>
									{vol
										.split('-')
										.map((w) => w.charAt(0).toUpperCase() + w.slice(1))
										.join(' ')}
								</option>
							))}
						</select>
					</div>

					<!-- Mechanic Filter -->
					<div>
						<label class='block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'>
							Mechanic
						</label>
						<select
							x-model='selectedMechanic'
							@change='filterAndSort()'
							class='w-full px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500'
						>
							<option value='all'>All Mechanics</option>
							{allMechanics.map((mechanic) => (
								<option value={mechanic}>
									{mechanic
										.split('-')
										.map((w) => w.charAt(0).toUpperCase() + w.slice(1))
										.join(' ')}
								</option>
							))}
						</select>
					</div>

					<!-- Sort By -->
					<div>
						<label class='block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'>
							Sort By
						</label>
						<select
							x-model='sortBy'
							@change='filterAndSort()'
							class='w-full px-4 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500'
						>
							{sortOptions.map((option) => (
								<option value={option.value}>{option.label}</option>
							))}
						</select>
					</div>
				</div>

				<!-- Quick Filters -->
				<div class='mb-4'>
					<label class='flex items-center'>
						<input
							type='checkbox'
							x-model='showBonusBuyOnly'
							@change='filterAndSort()'
							class='w-4 h-4 text-primary-600 bg-white dark:bg-gray-900 border-gray-300 dark:border-gray-600 rounded focus:ring-primary-500'
						/>
						<span class='ml-2 text-sm text-gray-700 dark:text-gray-300'>Bonus Buy Only</span>
					</label>
				</div>

				<!-- Clear Filters Button -->
				<button
					@click='clearFilters()'
					class='text-sm text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium'
				>
					Clear all filters
				</button>

				<!-- Results Count -->
				<p class='mt-4 text-sm text-gray-600 dark:text-gray-400'>
					Showing <span x-text='filteredSlots.length' class='font-semibold' /> of{' '}
					<span class='font-semibold'>{slots.length}</span> slots
				</p>
			</div>
		)
	}

	<!-- Slot Grid -->
	<div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6'>
		{
			slots.map((slot) => (
				<div x-show={`filteredSlots.some(s => s.slug === '${slot.data.slug}')`} x-transition>
					<SlotCard slotEntry={slot} />
				</div>
			))
		}
	</div>

	<!-- No Results Message -->
	<div
		x-show='filteredSlots.length === 0'
		x-transition
		class='text-center py-12 text-gray-500 dark:text-gray-400'
	>
		<p class='text-lg font-medium mb-2'>No slots found</p>
		<p class='text-sm'>Try adjusting your filters</p>
	</div>
</div>
