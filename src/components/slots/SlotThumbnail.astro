---
/**
 * SlotThumbnail
 *
 * Resolves a slot's thumbnail with graceful fallback, in priority order:
 *   1. The frontmatter `thumbnail` (existing slots that set image()).
 *   2. Convention: src/content/slots/images/thumbnails/<slug>.<ext> — auto-detected
 *      via import.meta.glob, which tolerates missing files. Drop a `<slug>.jpg`
 *      into that folder later and it is picked up on the next build, with NO
 *      frontmatter or code change required.
 *   3. A name-based inline SVG placeholder (so pages never look broken).
 *
 * The SVG is a backup only; real art always wins once present.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	slot: CollectionEntry<'slots'>['data'];
	/** Extra classes appended to the rendered <img>/<svg>. */
	class?: string;
	width?: number;
	height?: number;
	/** Eager-load (use for above-the-fold hero images). */
	eager?: boolean;
}

const {
	slot,
	class: className,
	width = 400,
	height = 225,
	eager = false,
} = Astro.props;

// Convention-based lookup of any real art already in the thumbnails folder.
const modules = import.meta.glob(
	'../../content/slots/images/thumbnails/*.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);
const bySlug: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(modules)) {
	const base = path.split('/').pop()!.replace(/\.[^.]+$/, '');
	bySlug[base] = (mod as { default: ImageMetadata }).default;
}

const resolved: ImageMetadata | null =
	slot.thumbnail ?? bySlug[slot.slug] ?? null;

// --- Name-based SVG placeholder (only used when no raster image exists) ---
function wrapName(name: string, maxLen = 15): string[] {
	const words = name.replace(/[™®]/g, '').split(/\s+/).filter(Boolean);
	const lines: string[] = [];
	let cur = '';
	for (const w of words) {
		if (cur && (cur + ' ' + w).length > maxLen) {
			lines.push(cur);
			cur = w;
		} else {
			cur = cur ? cur + ' ' + w : w;
		}
	}
	if (cur) lines.push(cur);
	return lines.slice(0, 4);
}
const lines = wrapName(slot.name);
// Deterministic hue from the name so each placeholder is stable + distinct.
let hue = 0;
for (let i = 0; i < slot.name.length; i++) {
	hue = (hue * 31 + slot.name.charCodeAt(i)) % 360;
}
const gid = `slot-thumb-${slot.slug}`;
const startY = 112 - (lines.length - 1) * 16;
---

{
	resolved ? (
		<Image
			src={resolved}
			alt={slot.name}
			width={width}
			height={height}
			class:list={['block w-full', className]}
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : 'auto'}
		/>
	) : (
		<svg
			viewBox="0 0 400 225"
			width={width}
			height={height}
			role="img"
			aria-label={`${slot.name} thumbnail placeholder`}
			preserveAspectRatio="xMidYMid slice"
			xmlns="http://www.w3.org/2000/svg"
			class:list={['block w-full', className]}
		>
			<defs>
				<linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color={`hsl(${hue}, 48%, 24%)`} />
					<stop offset="100%" stop-color={`hsl(${(hue + 38) % 360}, 58%, 12%)`} />
				</linearGradient>
			</defs>
			<rect width="400" height="225" fill={`url(#${gid})`} />
			<text
				x="200"
				y={startY}
				fill="#ffffff"
				font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				font-size="27"
				font-weight="700"
				text-anchor="middle"
			>
				{lines.map((line, i) => (
					<tspan x="200" dy={i === 0 ? 0 : 33}>
						{line}
					</tspan>
				))}
			</text>
			<text
				x="200"
				y="205"
				fill={`hsl(${hue}, 70%, 72%)`}
				font-family="system-ui, sans-serif"
				font-size="11"
				letter-spacing="2.5"
				text-anchor="middle"
				opacity="0.85"
			>
				MEGAWAYS ONLINE
			</text>
		</svg>
	)
}
