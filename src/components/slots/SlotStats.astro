---
/**
 * SlotStats Component
 *
 * Displays key slot statistics in a visually appealing grid
 */

import { Icon } from 'astro-icon/components';

interface Props {
	rtp?: number;
	volatility?: 'low' | 'medium' | 'medium-high' | 'high' | 'very-high';
	maxWin?: string;
	paylines?: number;
	reels?: number;
	rows?: string;
	minBet?: number;
	maxBet?: number;
	bonusBuy?: boolean;
	class?: string;
}

const {
	rtp,
	volatility,
	maxWin,
	paylines,
	reels,
	rows,
	minBet,
	maxBet,
	class: className = '',
} = Astro.props;

// Volatility color mapping
// 700-weight on light: the 600s fall under 4.5:1 on the gray-100 tile wells
const volatilityColors = {
	low: 'text-green-700 dark:text-green-400',
	medium: 'text-yellow-700 dark:text-yellow-400',
	'medium-high': 'text-orange-700 dark:text-orange-400',
	high: 'text-red-700 dark:text-red-400',
	'very-high': 'text-red-800 dark:text-red-500',
};

const volatilityColor = volatility ? volatilityColors[volatility] : '';

// Stats array
const stats = [
	{ label: 'RTP', value: rtp ? `${rtp}%` : null, icon: 'lucide:percent' },
	{
		label: 'Volatility',
		value: volatility ? volatility.replace('-', ' ') : null,
		icon: 'lucide:activity',
		colorClass: volatilityColor,
	},
	{ label: 'Max Win', value: maxWin, icon: 'lucide:trophy' },
	{
		label: 'Paylines',
		value: paylines ? paylines.toLocaleString() : null,
		icon: 'lucide:zap',
	},
	{ label: 'Reels', value: reels, icon: 'lucide:columns-3' },
	{ label: 'Rows', value: rows, icon: 'lucide:rows-3' },
	{
		label: 'Min Bet',
		value: minBet ? `$${minBet}` : null,
		icon: 'lucide:coins',
	},
	{
		label: 'Max Bet',
		value: maxBet ? `$${maxBet}` : null,
		icon: 'lucide:banknote',
	},
].filter((stat) => stat.value !== null && stat.value !== undefined);
---

{
	stats.length > 0 && (
		<div class={`grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 ${className}`}>
			{stats.map((stat) => (
				<div class='rounded-xl bg-gray-100 dark:bg-gray-800/60 px-3.5 py-3 min-w-0'>
					<span class='flex items-center gap-1.5 text-[0.6875rem] font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider mb-1'>
						<Icon
							name={stat.icon}
							size={13}
							class='text-primary-600 dark:text-primary-400 shrink-0'
						/>
						{stat.label}
					</span>
					<span
						class={`block font-display font-semibold text-gray-900 dark:text-white capitalize leading-snug ${stat.colorClass || ''}`}
					>
						{stat.value}
					</span>
				</div>
			))}
		</div>
	)
}
