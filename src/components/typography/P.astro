---
interface Props {
	class?: string;
	size?: 'sm' | 'md' | 'lg' | 'xl';
	variant?: 'body' | 'lead' | 'small';
	/** Extra attributes (id, aria-*, data-*) forwarded to the <p> */
	[key: string]: any;
}

const { class: className = '', size = 'md', variant = 'body', ...rest } = Astro.props;

const sizeClasses = {
	sm: 'text-sm',
	md: 'text-base',
	lg: 'text-lg',
	xl: 'text-xl',
};

const variantClasses = {
	body: 'leading-relaxed mb-4',
	lead: 'leading-relaxed mb-6 font-medium',
	small: 'leading-normal mb-2',
};
---

<p
	class:list={[
		'text-gray-700 dark:text-gray-300',
		sizeClasses[size],
		variantClasses[variant],
		className,
	]}
	{...rest}
>
	<slot />
</p>
