---
interface Props {
	class?: string;
	size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { class: className = '', size = 'md' } = Astro.props;

const sizeClasses = {
	sm: 'text-base md:text-lg',
	md: 'text-lg md:text-xl',
	lg: 'text-xl md:text-2xl lg:text-3xl',
	xl: 'text-2xl md:text-3xl lg:text-4xl',
};
---

<h4
	class:list={[
		'font-semibold',
		'text-gray-900 dark:text-white mb-3',
		sizeClasses[size],
		className,
	]}
>
	<slot />
</h4>
