---
interface Props {
	class?: string;
	size?: 'sm' | 'md' | 'lg' | 'xl';
	id?: string;
}

const { class: className = '', size = 'lg', id } = Astro.props;

const sizeClasses = {
	sm: 'text-2xl md:text-3xl',
	md: 'text-3xl md:text-4xl',
	lg: 'text-4xl md:text-5xl lg:text-6xl',
	xl: 'text-5xl md:text-6xl lg:text-7xl',
};
---

<h1
	id={id}
	class:list={[
		'font-bold',
		'text-gray-900 dark:text-white mb-8',
		sizeClasses[size],
		className,
	]}
>
	<slot />
</h1>
