---
interface Props {
	class?: string;
	size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { class: className = '', size = 'md' } = Astro.props;

const sizeClasses = {
	sm: 'text-lg md:text-xl',
	md: 'text-xl md:text-2xl',
	lg: 'text-2xl md:text-3xl lg:text-4xl',
	xl: 'text-3xl md:text-4xl lg:text-5xl',
};
---

<h3
	class:list={[
		'font-bold',
		'text-gray-900 dark:text-white mb-4',
		sizeClasses[size],
		className,
	]}
>
	<slot />
</h3>
