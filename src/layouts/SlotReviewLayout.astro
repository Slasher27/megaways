---
/**
 * SlotReviewLayout — thin adapter over ReviewShell: computes slot-specific
 * title/description/breadcrumbs and injects the slot JSON-LD.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getEntry } from 'astro:content';
import ReviewShell from './ReviewShell.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import SlotSchema from '../components/seo/SlotSchema.astro';

interface Props {
	slotEntry: CollectionEntry<'slots'>;
	/** h2 headings from render() — drives the "On this page" aside. */
	headings?: MarkdownHeading[];
	title?: string;
	description?: string;
}

const { slotEntry, headings = [], title, description } = Astro.props;

const pageTitle =
	title ||
	slotEntry.data.title ||
	`${slotEntry.data.name} Review | Megaways Online`;
const pageDescription =
	description ||
	slotEntry.data.description ||
	`Read our ${slotEntry.data.name} review. RTP ${slotEntry.data.rtp}%, max win ${slotEntry.data.maxWin}, ${slotEntry.data.paylines} ways to win.`;

const ogImage = slotEntry.data.thumbnail?.src || slotEntry.data.logo?.src;
const publishedTime = slotEntry.data.publishedDate?.toISOString();
const modifiedTime = slotEntry.data.updatedDate?.toISOString();

const author = slotEntry.data.author
	? await getEntry(slotEntry.data.author)
	: null;

const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Online Slots', href: '/online-slots/' },
	{ label: slotEntry.data.name, href: `/online-slots/${slotEntry.data.slug}/` },
];
---

<ReviewShell
	title={pageTitle}
	description={pageDescription}
	image={ogImage}
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	breadcrumbItems={breadcrumbItems}
	headings={headings}
>
	<BreadcrumbSchema slot='schema' items={breadcrumbItems} />
	<SlotSchema
		slot='schema'
		slotData={slotEntry.data}
		author={author?.data}
		url={Astro.url.href}
	/>
	<slot />
</ReviewShell>
