---
/**
 * CasinoReviewLayout
 *
 * Layout specifically designed for casino review pages
 * Includes BaseLayout, Header, Footer, Container, and Breadcrumbs
 */

import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/layout/Container.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';

interface Props {
	casino: CollectionEntry<'casinos'>;
	title?: string;
	description?: string;
}

const { casino, title, description } = Astro.props;

// Build page title and description
const pageTitle =
	title || `${casino.data.name} Review ${new Date().getFullYear()} | Bonuses & Games`;
const pageDescription =
	description ||
	(casino.data.welcomeBonus
		? `${casino.data.name} review. Get ${casino.data.welcomeBonus.amount}. Read our expert review of bonuses, games, and payment methods.`
		: `Read our expert ${casino.data.name} review covering bonuses, games, payment methods, and more.`);

// Build breadcrumb items
const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Online Casinos', href: '/online-casinos/' },
	{ label: casino.data.name, href: `/online-casinos/${casino.data.slug}-casino-review/` },
];
---

<!-- Breadcrumb Schema for SEO -->
<BreadcrumbSchema items={breadcrumbItems} />

<BaseLayout title={pageTitle} description={pageDescription}>
	<div class="flex min-h-screen flex-col">
		<!-- Header -->
		<Header />

		<!-- Main Content -->
		<main class="flex-1">
			<Container>
				<!-- Breadcrumb Navigation -->
				<Breadcrumb items={breadcrumbItems} class="mb-6" />

				<!-- Two Column Layout: Main Content + Sidebar -->
				<div class="flex flex-col lg:flex-row gap-8">
					<!-- Main Content Column (left-aligned) -->
					<article class="flex-1 min-w-0">
						<slot />
					</article>

					<!-- Sidebar Column (placeholder for future aside) -->
					<!-- <aside class="w-full lg:w-80 flex-shrink-0">
						Sidebar content here
					</aside> -->
				</div>
			</Container>
		</main>

		<!-- Footer -->
		<Footer />
	</div>
</BaseLayout>
