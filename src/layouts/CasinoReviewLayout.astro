---
/**
 * CasinoReviewLayout — thin adapter over ReviewShell: computes casino-specific
 * title/description/breadcrumbs and injects the casino JSON-LD.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getEntry } from 'astro:content';
import ReviewShell from './ReviewShell.astro';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import CasinoSchema from '../components/seo/CasinoSchema.astro';

interface Props {
	casino: CollectionEntry<'casinos'>;
	/** h2 headings from render() — drives the "On this page" aside. */
	headings?: MarkdownHeading[];
	title?: string;
	description?: string;
}

const { casino, headings = [], title, description } = Astro.props;

const pageTitle =
	title ||
	casino.data.title ||
	`${casino.data.name} Review ${new Date().getFullYear()} | Bonuses & Games`;
const pageDescription =
	description ||
	casino.data.description ||
	(casino.data.welcomeBonus
		? `${casino.data.name} review. Get ${casino.data.welcomeBonus.amount}. Read our expert review of bonuses, games, and payment methods.`
		: `Read our expert ${casino.data.name} review covering bonuses, games, payment methods, and more.`);

const ogImage = casino.data.thumbnail?.src || casino.data.logo?.src;
const publishedTime = casino.data.publishedDate?.toISOString();
const modifiedTime = casino.data.updatedDate?.toISOString();

const author = casino.data.author ? await getEntry(casino.data.author) : null;

const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Online Casinos', href: '/online-casinos/' },
	{
		label: casino.data.name,
		href: `/online-casinos/${casino.data.slug}-casino-review/`,
	},
];
---

<ReviewShell
	title={pageTitle}
	description={pageDescription}
	image={ogImage}
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	breadcrumbItems={breadcrumbItems}
	headings={headings}
>
	<BreadcrumbSchema slot='schema' items={breadcrumbItems} />
	<CasinoSchema
		slot='schema'
		casino={casino.data}
		author={author?.data}
		url={Astro.url.href}
	/>
	<slot />
</ReviewShell>
