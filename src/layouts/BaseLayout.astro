---
/// <reference path="../alpine.d.ts" />
import '../styles/global.css';
import SEOHead from '../components/seo/SEOHead.astro';
import BackToTop from '../components/layout/BackToTop.astro';

interface Props {
	title: string;
	description: string;
	/** Open Graph image path */
	image?: string;
	/** Open Graph type (website or article) */
	type?: 'website' | 'article';
	/** Whether to noindex this page */
	noindex?: boolean;
	/** Author name for article type */
	author?: string;
	/** Published date for article type */
	publishedTime?: string;
	/** Modified date for article type */
	modifiedTime?: string;
}

const {
	title,
	description,
	image,
	type = 'website',
	noindex = false,
	author,
	publishedTime,
	modifiedTime,
} = Astro.props;
---

<!DOCTYPE html>
<html lang='en' class='scroll-smooth'>
	<head>
		<meta charset='utf-8' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<meta name='generator' content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<SEOHead
			title={title}
			description={description}
			canonical={Astro.url.href}
			type={type}
			image={image}
			noindex={noindex}
			author={author}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>

		<!-- Theme initialization (prevent flash) -->
		<script is:inline>
			// Check localStorage or system preference before page renders
			if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>

		<!-- Alpine.js (core only — no plugins; used by NavDropdown + Search) -->
		<script>
			import Alpine from 'alpinejs';

			// Make Alpine available globally
			window.Alpine = Alpine;

			// Start Alpine
			Alpine.start();
		</script>

		<!-- Vercel Web Analytics (cookieless, privacy-first — see /privacy/).
		     Plain script integration: the @vercel/analytics package is not needed
		     for a static site and conflicts with Astro's vite peer range. -->
		{
			import.meta.env.PROD && (
				<>
					<script is:inline>
						window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
					</script>
					<script is:inline defer src='/_vercel/insights/script.js'></script>
				</>
			)
		}

		<!-- Search keyboard shortcuts -->
		<script>
			document.addEventListener('keydown', (e) => {
				// Check if the user pressed "/" or Cmd/Ctrl+K
				const isSlash = e.key === '/' && !e.metaKey && !e.ctrlKey;
				const isCmdK = e.key === 'k' && (e.metaKey || e.ctrlKey);

				// Don't trigger if user is typing in an input, textarea, or contenteditable
				const activeEl = document.activeElement as HTMLElement;
				const isTyping =
					activeEl?.tagName === 'INPUT' ||
					activeEl?.tagName === 'TEXTAREA' ||
					activeEl?.isContentEditable === true;

				if ((isSlash || isCmdK) && !isTyping) {
					e.preventDefault();
					// Dispatch custom event that the Search component will listen for
					window.dispatchEvent(new CustomEvent('focus-search'));
				}
			});
		</script>
	</head>
	<body class='min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200'>
		<slot />

		<!-- Back to Top Button -->
		<BackToTop />
	</body>
</html>
