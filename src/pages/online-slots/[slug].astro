---
// Dynamic route for slot reviews
// URL pattern: /online-slots/[slug]/
// Example: /online-slots/celestial-sisters-megaways/

import {
	getCollection,
	render,
	type CollectionEntry,
	getEntry,
} from 'astro:content';
import SlotReviewLayout from '../../layouts/SlotReviewLayout.astro';
import SlotThumbnail from '../../components/slots/SlotThumbnail.astro';
import H1 from '../../components/typography/H1.astro';
import H2 from '../../components/typography/H2.astro';
import P from '../../components/typography/P.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';

// New review components
import Rating from '../../components/reviews/Rating.astro';
import ProsCons from '../../components/reviews/ProsCons.astro';
import AuthorCard from '../../components/reviews/AuthorCard.astro';
import SlotStats from '../../components/slots/SlotStats.astro';
import WhereToPlay from '../../components/slots/WhereToPlay.astro';

export async function getStaticPaths() {
	const slots = await getCollection('slots');

	return slots.map((slot) => ({
		params: { slug: slot.data.slug },
		props: { slot },
	}));
}

interface Props {
	slot: CollectionEntry<'slots'>;
}

const { slot } = Astro.props;

// Render content for the slot
const { Content } = await render(slot);

// Get author details if available (author is already a reference)
const author = slot.data.author ? await getEntry(slot.data.author) : null;
---

<SlotReviewLayout slotEntry={slot}>
	<!-- Hero Section -->
	<header class='mb-10'>
		<!-- Provider Badge -->
		<div class='flex flex-wrap items-center gap-3 mb-4'>
			{
				slot.data.provider && (
					<Badge variant='secondary' size='md'>
						<span class='capitalize'>
							{slot.data.provider.replace('-', ' ')}
						</span>
					</Badge>
				)
			}
		</div>

		<!-- Heading -->
		<H1 size='md' class='mb-6'>{slot.data.h1Tag || slot.data.name}</H1>

		<!-- Description -->
		{
			slot.data.description && (
				<P
					variant='lead'
					size='lg'
					class='text-gray-700 dark:text-gray-300 mb-8'
				>
					{slot.data.description}
				</P>
			)
		}

		<!-- Hero Content: Image + Stats/Features (Row on Desktop, Column on Mobile) -->
		<div class='flex flex-col lg:flex-row lg:items-start gap-6 mb-8'>
			<!-- Thumbnail -->
			<div class='flex flex-col gap-4 lg:gap-6'>
				<div class='lg:w-100 shrink-0 rounded-xl overflow-hidden'>
					<SlotThumbnail
						slot={slot.data}
						width={400}
						height={225}
						eager={true}
						class='h-auto'
					/>
				</div>
				<div class='flex flex-row items-center justify-center gap-4'>
					<Button variant='secondary'>Play Demo</Button>
					<Button variant='primary'>Where to play</Button>
				</div>
			</div>
			<!-- Stats & Features -->
			<div
				class='flex-1 bg-linear-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 rounded-xl p-6 border border-gray-200 dark:border-gray-700'
			>
				<SlotStats
					rtp={slot.data.rtp}
					volatility={slot.data.volatility}
					maxWin={slot.data.maxWin}
					paylines={slot.data.paylines}
					reels={slot.data.reels}
					rows={slot.data.rows}
					minBet={slot.data.minBet}
					maxBet={slot.data.maxBet}
					bonusBuy={slot.data.bonusBuy}
					class='bg-transparent! border-0! p-0! mb-6'
				/>

				<!-- Features -->
				{
					slot.data.features?.length > 0 && (
						<div class='pt-4 border-t border-gray-300 dark:border-gray-700'>
							<p class='text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-2'>
								Features
							</p>
							<div class='flex flex-wrap gap-1.5'>
								{slot.data.features.map((feature) => (
									<span class='px-2 py-0.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded text-xs capitalize'>
										{feature}
									</span>
								))}
							</div>
						</div>
					)
				}
			</div>
		</div>
	</header>

	<!-- Review Content -->
	<section class='prose prose-lg dark:prose-invert max-w-none mb-10'>
		<Content />
	</section>

	<!-- Pros & Cons -->
	<ProsCons pros={slot.data.pros} cons={slot.data.cons} class='mb-10' />

	<!-- Where to Play -->
	<div id='where-to-play'>
		<WhereToPlay slotName={slot.data.name} class='mb-10' />
	</div>

	<!-- Author Card -->
	{
		author && (
			<AuthorCard
				author={author}
				publishedDate={slot.data.publishedDate}
				updatedDate={slot.data.updatedDate}
				variant='full'
				class='mb-10'
			/>
		)
	}

	<!-- Final Rating Summary -->
	{
		slot.data.rating && (
			<section class='bg-linear-to-br from-primary-50 to-blue-50 dark:from-primary-900/20 dark:to-blue-900/20 rounded-xl p-8 text-center border border-primary-200 dark:border-primary-800'>
				<h3 class='text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4'>
					Our Rating
				</h3>
				<div class='flex items-center justify-center gap-4 mb-4'>
					<Rating rating={slot.data.rating} size='xl' />
				</div>
				<P class='text-gray-700 dark:text-gray-300 max-w-2xl mx-auto'>
					{slot.data.name} scores {slot.data.rating} out of 5 stars in our
					review.
					{slot.data.rating >= 4.5 && ' Highly recommended for all players.'}
					{slot.data.rating >= 4 &&
						slot.data.rating < 4.5 &&
						' A solid choice worth trying.'}
					{slot.data.rating >= 3 &&
						slot.data.rating < 4 &&
						' Decent slot with some good features.'}
					{slot.data.rating < 3 &&
						' May appeal to specific player preferences.'}
				</P>
			</section>
		)
	}
</SlotReviewLayout>
