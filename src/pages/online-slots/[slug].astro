---
// Dynamic route for slot reviews
// URL pattern: /online-slots/[slug]/
// Example: /online-slots/celestial-sisters-megaways/

import {
	getCollection,
	render,
	type CollectionEntry,
	getEntry,
} from 'astro:content';
import SlotReviewLayout from '../../layouts/SlotReviewLayout.astro';
import SlotThumbnail from '../../components/slots/SlotThumbnail.astro';
import SlotDemo from '../../components/slots/SlotDemo.astro';
import H1 from '../../components/typography/H1.astro';
import P from '../../components/typography/P.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import TocCard from '../../components/reviews/TocCard.astro';
import Tile from '../../components/ui/Tile.astro';
import TileGrid from '../../components/ui/TileGrid.astro';
import Callout from '../../components/ui/Callout.astro';
import ReviewMeta from '../../components/reviews/ReviewMeta.astro';
import VerifiedChip from '../../components/reviews/VerifiedChip.astro';
import Scorecard from '../../components/reviews/Scorecard.astro';
import Faq from '../../components/reviews/Faq.astro';
import Screenshot from '../../components/reviews/Screenshot.astro';
import SessionLog from '../../components/reviews/SessionLog.astro';
import ReviewChangeLog from '../../components/reviews/ReviewChangeLog.astro';
import PaytableTable from '../../components/slots/PaytableTable.astro';
import RTPRangeCallout from '../../components/slots/RTPRangeCallout.astro';
import ReelLayout from '../../components/slots/ReelLayout.astro';
import RelatedSlots from '../../components/slots/RelatedSlots.astro';
import RTPContextBar from '../../components/slots/RTPContextBar.astro';
import VolatilityMeter from '../../components/slots/VolatilityMeter.astro';
import WinPotentialPanel from '../../components/slots/WinPotentialPanel.astro';
import CompareTable from '../../components/slots/CompareTable.astro';
import ActionBar from '../../components/layout/ActionBar.astro';
import { providerSlug } from '../../data/providers';

// New review components
import ProsCons from '../../components/reviews/ProsCons.astro';
import AuthorCard from '../../components/reviews/AuthorCard.astro';
import SlotStats from '../../components/slots/SlotStats.astro';
import WhereToPlay from '../../components/slots/WhereToPlay.astro';

export async function getStaticPaths() {
	const slots = await getCollection('slots');

	return slots.map((slot) => ({
		params: { slug: slot.data.slug },
		props: { slot },
	}));
}

interface Props {
	slot: CollectionEntry<'slots'>;
}

const { slot } = Astro.props;

// Render content for the slot; h2 headings drive the two TOCs
const { Content, headings } = await render(slot);
const toc = headings.filter((heading) => heading.depth === 2);

// Get author details if available (author is already a reference)
const author = slot.data.author ? await getEntry(slot.data.author) : null;
---

<SlotReviewLayout slotEntry={slot} headings={toc}>
	<!-- Hero Section -->
	<header class='mb-10'>
		<!-- Provider eyebrow -->
		{
			slot.data.provider && (
				<a
					href={`/online-slots/${providerSlug(slot.data.provider)}/`}
					class='inline-block text-xs font-bold uppercase tracking-[0.14em] text-primary-700 dark:text-primary-400 hover:text-primary-800 dark:hover:text-primary-300 mb-3'
				>
					{slot.data.provider}
				</a>
			)
		}

		<!-- Heading -->
		<H1 size='md' class='mb-4'>{slot.data.h1Tag || slot.data.name}</H1>

		<!-- Rating + review meta + stat provenance -->
		<div class='flex flex-wrap items-center gap-x-4 gap-y-2 mb-5'>
			<ReviewMeta
				rating={slot.data.rating}
				updatedDate={slot.data.updatedDate}
			/>
			<VerifiedChip verified={slot.data.verified} />
		</div>

		<!-- Description -->
		{
			slot.data.description && (
				<P
					variant='lead'
					size='lg'
					class='text-gray-600 dark:text-gray-400 mb-8'
				>
					{slot.data.description}
				</P>
			)
		}

		<!-- Hero Content: Image + Stats/Features (Row on Desktop, Column on Mobile).
		     While a demo iframe is active, SlotDemo's global styles expand the demo
		     column to full width (stats wrap below) — see SlotDemo.astro. -->
		<div class='slot-hero flex flex-col lg:flex-row lg:items-start gap-6 mb-8'>
			<!-- Thumbnail / click-to-load demo facade -->
			<div class='demo-col flex flex-col gap-4 lg:gap-5'>
				<div class='lg:w-100 shrink-0 rounded-2xl overflow-hidden shadow-sm'>
					{
						slot.data.demoUrl ? (
							<SlotDemo slotData={slot.data} eager={true} />
						) : (
							<SlotThumbnail
								slotData={slot.data}
								width={400}
								height={225}
								eager={true}
								class='h-auto'
							/>
						)
					}
				</div>
				<!-- Desktop CTAs; on mobile the sticky action bar takes over -->
				<div class='hidden lg:flex flex-row items-center justify-center gap-3'>
					{
						slot.data.demoUrl && (
							<Button variant='secondary' class='js-play-demo'>
								Play Demo
							</Button>
						)
					}
					<Button variant='primary' href='#where-to-play'>Where to play</Button>
				</div>
			</div>
			<!-- Stats & Features: raised card, tiles are sunken wells -->
			<Card padding='none' class='flex-1 p-4 sm:p-5'>
				<SlotStats
					rtp={slot.data.rtp}
					volatility={slot.data.volatility}
					maxWin={slot.data.maxWin}
					paylines={slot.data.paylines}
					reels={slot.data.reels}
					rows={slot.data.rows}
					minBet={slot.data.minBet}
					maxBet={slot.data.maxBet}
					bonusBuy={slot.data.bonusBuy}
					class='mb-5'
				/>

				<!-- Features -->
				{
					slot.data.features?.length > 0 && (
						<div class='pt-4 border-t border-gray-100 dark:border-gray-800'>
							<p class='text-[0.6875rem] font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2'>
								Features
							</p>
							<div class='flex flex-wrap gap-1.5'>
								{slot.data.features.map((feature) => (
									<span class='px-2.5 py-1 bg-primary-50 text-primary-800 dark:bg-primary-950/60 dark:text-primary-300 rounded-full text-xs font-medium capitalize'>
										{feature}
									</span>
								))}
							</div>
						</div>
					)
				}
			</Card>
		</div>
	</header>

	<!-- On this page (mobile/tablet; xl+ uses the sticky aside in the layout) -->
	<TocCard headings={toc} class='mb-8' />

	<!-- Review Content (fills the article column; container + TOC bound it).
	     Protocol components (docs/REVIEW-PROTOCOL.md) available in MDX without
	     imports; frontmatter props via the MDX `frontmatter` binding. -->
	<section class='review-prose prose prose-lg dark:prose-invert mb-10'>
		<Content
			components={{
				Tile,
				TileGrid,
				Callout,
				Scorecard,
				RTPContextBar,
				VolatilityMeter,
				WinPotentialPanel,
				CompareTable,
				Faq,
				Screenshot,
				SessionLog,
				WhereToPlay,
				PaytableTable,
				RTPRangeCallout,
				ReelLayout,
			}}
		/>
	</section>

	<!-- Pros & Cons -->
	<ProsCons pros={slot.data.pros} cons={slot.data.cons} class='mb-10' />

	<!-- Where to Play — protocol-format MDX places this itself (blueprint §10,
	     before the FAQs); only render here when the body hasn't. -->
	{
		!slot.body?.includes('<WhereToPlay') && (
			<div id='where-to-play'>
				<WhereToPlay slotName={slot.data.name} class='mb-10' />
			</div>
		)
	}

	<!-- Author Card -->
	{
		author && (
			<AuthorCard
				author={author}
				publishedDate={slot.data.publishedDate}
				updatedDate={slot.data.updatedDate}
				variant='full'
				class='mb-10'
			/>
		)
	}

	<!-- Review History (renders only when changelog entries exist) -->
	<ReviewChangeLog entries={slot.data.changelog} class='mb-10' />

	<!-- Related rails (blueprint §13): More {Provider} + More {Mechanic} -->
	<RelatedSlots current={slot.data} class='mb-10' />

	<!-- Sticky mobile action bar (hidden once the demo is playing) -->
	<ActionBar class='slot-action-bar'>
		{
			slot.data.demoUrl && (
				<Button variant='secondary' class='js-play-demo flex-1 justify-center'>
					Play Demo
				</Button>
			)
		}
		<Button
			variant='primary'
			href='#where-to-play'
			class='flex-1 justify-center'
		>
			Where to Play
		</Button>
	</ActionBar>

	<style is:global>
		/* Once a demo iframe is active the action bar disappears (its CTAs are
		   redundant while playing); mirrors SlotDemo's :has patterns. */
		body:has(.slot-demo iframe) .slot-action-bar {
			display: none;
		}
	</style>

	<script>
		// Hero "Play Demo" button starts the facade's demo (SlotDemo listens).
		document.querySelectorAll('.js-play-demo').forEach((btn) =>
			btn.addEventListener('click', () =>
				window.dispatchEvent(new CustomEvent('load-slot-demo')),
			),
		);
	</script>
</SlotReviewLayout>
