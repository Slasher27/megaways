---
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/layout/Container.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Breadcrumb from '../../../components/layout/Breadcrumb.astro';
import BreadcrumbSchema from '../../../components/seo/BreadcrumbSchema.astro';
import H1 from '../../../components/typography/H1.astro';
import H2 from '../../../components/typography/H2.astro';
import H3 from '../../../components/typography/H3.astro';
import P from '../../../components/typography/P.astro';
import SlotCard from '../../../components/slots/SlotCard.astro';

export const getStaticPaths = (async ({ paginate }) => {
	const providerSlug = 'yggdrasil';

	// Get all slots from this provider
	const allSlots = await getCollection('slots');
	const providerSlots = allSlots.filter((slot) => {
		const slotProvider = slot.data.provider.toLowerCase().replace(/\s+/g, '-');
		return slotProvider === providerSlug || slotProvider === 'jelly';
	});

	// Sort by rating (highest first), then by name
	providerSlots.sort((a, b) => {
		if (a.data.rating && b.data.rating) {
			if (b.data.rating !== a.data.rating) {
				return b.data.rating - a.data.rating;
			}
		}
		return a.data.name.localeCompare(b.data.name);
	});

	// Generate paginated routes (12 slots per page)
	return paginate(providerSlots, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Get provider info
const providerSlug = 'yggdrasil';
const provider = await getEntry('providers', providerSlug);

if (!provider) {
	throw new Error(`Provider '${providerSlug}' not found`);
}

const { Content } = await render(provider);

const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Slots', href: '/online-slots/' },
	{ label: provider.data.name, href: `/online-slots/${providerSlug}/` },
];

const pageTitle = page.currentPage === 1
	? `${provider.data.name} Megaways Slots ${new Date().getFullYear()} | Best ${provider.data.name} Games`
	: `${provider.data.name} Megaways Slots | Page ${page.currentPage}`;
const pageDescription =
	provider.data.description ||
	`Explore all ${provider.data.name} Megaways slots. Read detailed reviews with RTP, features, and where to play.`;
---

<BreadcrumbSchema items={breadcrumbItems} />

<PageLayout title={pageTitle} description={pageDescription}>
	<Header slot='header' />

	<Container>
		<Breadcrumb items={breadcrumbItems} class='mb-6' />

		<!-- Provider Header -->
		<header class='mb-12'>
			<H1 size='lg'>{provider.data.name} Megaways Slots</H1>
			<P variant='lead' class='mb-6'>
				{provider.data.description}
			</P>

			<div class='text-gray-600 dark:text-gray-400'>
				<strong>{page.total}</strong>{' '}
				{page.total === 1 ? 'slot' : 'slots'} available
			</div>
		</header>

		<!-- Slots Section -->
		<section aria-labelledby="slots-heading">
			<H2 id="slots-heading" size="md" class="mb-4">{provider.data.name} Slots</H2>

			<!-- Slot Count -->
			<div class="mb-8">
				<P class="text-gray-600 dark:text-gray-400">
					Showing {page.start + 1}-{page.end + 1} of {page.total} {page.total === 1 ? 'slot' : 'slots'}
				</P>
			</div>

			<!-- Slots Grid -->
			{
				page.data.length > 0 ? (
					<div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12'>
						{page.data.map((slotEntry, index) => (
							<SlotCard slotEntry={slotEntry} eager={page.currentPage === 1 && index < 6} />
						))}
					</div>
				) : (
					<div class='text-center py-12 bg-gray-50 dark:bg-gray-800/50 rounded-xl'>
						<P class='text-gray-600 dark:text-gray-400'>
							No slots available yet. Check back soon!
						</P>
					</div>
				)
			}

			<!-- Pagination Controls -->
			{page.lastPage > 1 && (
				<div class="mt-12 flex items-center justify-center gap-2">
					<!-- Previous Button -->
					{page.url.prev ? (
						<a
							href={page.url.prev}
							class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
						>
							← Previous
						</a>
					) : (
						<span class="px-4 py-2 bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg text-gray-400 dark:text-gray-600 cursor-not-allowed">
							← Previous
						</span>
					)}

					<!-- Page Numbers -->
					<div class="flex gap-1">
						{Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => {
							const pageUrl = pageNum === 1 ? `/online-slots/${providerSlug}/` : `/online-slots/${providerSlug}/${pageNum}/`;
							return pageNum === page.currentPage ? (
								<span class="px-4 py-2 bg-primary-600 text-white rounded-lg font-semibold">
									{pageNum}
								</span>
							) : (
								<a
									href={pageUrl}
									class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
								>
									{pageNum}
								</a>
							);
						})}
					</div>

					<!-- Next Button -->
					{page.url.next ? (
						<a
							href={page.url.next}
							class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
						>
							Next →
						</a>
					) : (
						<span class="px-4 py-2 bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg text-gray-400 dark:text-gray-600 cursor-not-allowed">
							Next →
						</span>
					)}
				</div>
			)}
		</section>

		<!-- Provider Description (only on page 1) -->
		{page.currentPage === 1 && (
			<article
				class='prose prose-lg dark:prose-invert max-w-none mb-12 bg-gray-50 dark:bg-gray-800/50 rounded-xl p-8 mt-12'
			>
				<Content />
			</article>
		)}

		<!-- CTA (only on page 1) -->
		{page.currentPage === 1 && (
			<div class='bg-gradient-to-r from-primary-50 to-primary-100 dark:from-primary-900/20 dark:to-primary-800/20 rounded-xl p-8 text-center'>
				<H3 size='md' class='mb-4'>
					Explore More Megaways Slots
				</H3>
				<P class='mb-6'>
					Discover our complete collection of Megaways slot reviews from all
					providers.
				</P>
				<a
					href='/online-slots/'
					class='inline-flex items-center justify-center font-semibold rounded-lg transition-colors cursor-pointer px-6 py-3 bg-primary-600 text-white hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600'
				>
					View All Slots
				</a>
			</div>
		)}
	</Container>

	<Footer slot='footer' />
</PageLayout>
