---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/layout/Container.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import H1 from '../../components/typography/H1.astro';
import P from '../../components/typography/P.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import SlotCard from '../../components/slots/SlotCard.astro';

// Get all slots from content collection
const allSlots = await getCollection('slots');

// Sort slots by name alphabetically
const sortedSlots = allSlots.sort((a, b) => a.data.name.localeCompare(b.data.name));

const metadata = {
	title: 'Online Slots Reviews | Megaways & More',
	description: 'Comprehensive reviews of online slots including Megaways, features, RTP, volatility, and where to play. Expert analysis and ratings.',
};

// Build breadcrumb items
const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Online Slots', href: '/online-slots/' },
];
---

<!-- Breadcrumb Schema for SEO -->
<BreadcrumbSchema items={breadcrumbItems} />

<PageLayout title={metadata.title} description={metadata.description}>
	<Header slot='header' />

	<Container>
		<!-- Breadcrumb Navigation -->
		<Breadcrumb items={breadcrumbItems} class="mb-6" />

		<div class="mb-12">
			<H1 size="lg">Online Slots</H1>
			<P variant="lead" size="lg" class="mt-4">
				Browse our comprehensive collection of slot reviews. Find detailed information on RTP, volatility, features, and the best casinos to play.
			</P>
		</div>

		<!-- Slot Count -->
		<div class="mb-8">
			<P class="text-gray-600 dark:text-gray-400">
				Showing {sortedSlots.length} {sortedSlots.length === 1 ? ' slot' : ' slots'}
			</P>
		</div>

		<!-- Slots Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{sortedSlots.map((slotEntry) => (
				<SlotCard slotEntry={slotEntry} />
			))}
		</div>

		<!-- Empty State -->
		{sortedSlots.length === 0 && (
			<div class="text-center py-12">
				<P class="text-gray-500 dark:text-gray-400">
					No slots found. Check back soon!
				</P>
			</div>
		)}
	</Container>

	<Footer slot='footer' />
</PageLayout>
