---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/layout/Container.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import H1 from '../../../components/typography/H1.astro';
import H2 from '../../../components/typography/H2.astro';
import P from '../../../components/typography/P.astro';
import Badge from '../../../components/ui/Badge.astro';
import Breadcrumb from '../../../components/layout/Breadcrumb.astro';
import BreadcrumbSchema from '../../../components/seo/BreadcrumbSchema.astro';
import { Icon } from 'astro-icon/components';

const authors = await getCollection('authors');
const profiles = await Promise.all(
	authors.map(async (author) => ({ author, Content: (await render(author)).Content })),
);

const pageTitle = 'Our Team | The Experts Behind Megaways Online';
const pageDescription =
	'Meet the reviewers behind Megaways Online. Every slot and casino review carries a named author with real industry experience — here is who we are.';

const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/about/' },
	{ label: 'Our Team', href: '/about/team/' },
];

// Person JSON-LD for each real author profile on this page
const personSchema = {
	'@context': 'https://schema.org',
	'@graph': authors.map((author) => ({
		'@type': 'Person',
		name: author.data.name,
		jobTitle: author.data.role,
		description: author.data.shortBio,
		url: 'https://megawaysonline.com/about/team/',
		worksFor: { '@type': 'Organization', name: 'Megaways Online' },
		knowsAbout: author.data.expertise,
		sameAs: [author.data.socials?.linkedin, author.data.socials?.twitter, author.data.socials?.website].filter(Boolean),
	})),
};
---

<BreadcrumbSchema items={breadcrumbItems} />
<script type='application/ld+json' set:html={JSON.stringify(personSchema)} />

<PageLayout title={pageTitle} description={pageDescription}>
	<Header slot='header' />

	<Container>
		<Breadcrumb items={breadcrumbItems} class='mb-6' />

		<header class='mb-12 max-w-3xl'>
			<H1 size='lg'>Our Team</H1>
			<P variant='lead' size='lg' class='mb-0'>
				Every review on Megaways Online is researched, played and written by a real, named
				reviewer — no anonymous content, no outsourced filler. Here's who does the work and
				how to reach them.
			</P>
		</header>

		{profiles.map(({ author, Content }) => (
			<article class='mb-16 max-w-4xl'>
				<div class='rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 md:p-8 mb-8'>
					<div class='flex flex-col sm:flex-row sm:items-center gap-6'>
						<span
							class='flex size-20 shrink-0 items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900/50 text-2xl font-bold text-primary-700 dark:text-primary-300'
							aria-hidden='true'
						>
							{author.data.name.split(' ').map((part) => part[0]).join('')}
						</span>
						<div class='min-w-0'>
							<H2 size='md' class='mb-1'>{author.data.name}</H2>
							<P class='text-primary-600 dark:text-primary-400 font-medium mb-2'>
								{author.data.role}
								{author.data.yearsExperience && (
									<span class='text-gray-500 dark:text-gray-400 font-normal'>
										&nbsp;· {author.data.yearsExperience}+ years in the industry
									</span>
								)}
							</P>
							{(author.data.socials?.linkedin || author.data.socials?.twitter || author.data.socials?.website) && (
								<div class='flex gap-4 text-sm'>
									{author.data.socials?.linkedin && (
										<a
											href={author.data.socials.linkedin}
											rel='noopener'
											target='_blank'
											class='inline-flex items-center gap-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400'
										>
											<Icon name='lucide:linkedin' class='size-4' aria-hidden='true' /> LinkedIn
										</a>
									)}
									{author.data.socials?.twitter && (
										<a
											href={author.data.socials.twitter}
											rel='noopener'
											target='_blank'
											class='inline-flex items-center gap-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400'
										>
											<Icon name='lucide:twitter' class='size-4' aria-hidden='true' /> Twitter
										</a>
									)}
									{author.data.socials?.website && (
										<a
											href={author.data.socials.website}
											rel='noopener'
											target='_blank'
											class='inline-flex items-center gap-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400'
										>
											<Icon name='lucide:globe' class='size-4' aria-hidden='true' /> Website
										</a>
									)}
								</div>
							)}
						</div>
					</div>

					{author.data.expertise && author.data.expertise.length > 0 && (
						<div class='flex flex-wrap gap-2 mt-6'>
							{author.data.expertise.map((topic) => (
								<Badge variant='primary' size='sm'>{topic}</Badge>
							))}
						</div>
					)}

					{author.data.bio && (
						<P class='mt-6 mb-0 text-gray-600 dark:text-gray-400'>{author.data.bio}</P>
					)}
				</div>

				<div class='prose dark:prose-invert max-w-none'>
					<Content />
				</div>
			</article>
		))}

		<section class='mb-16 max-w-4xl'>
			<div class='rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-6 md:p-8'>
				<H2 size='sm' class='mb-3'>How we work</H2>
				<P class='text-gray-600 dark:text-gray-400 mb-0'>
					Every stat we publish — RTP, max win, volatility — is verified against the
					provider's official data before it goes live, and every review carries a
					visible published and updated date. Read the full
					<a href='/about/methodology/' class='underline hover:text-primary-600 dark:hover:text-primary-400'>review methodology</a>
					to see exactly how ratings are produced.
				</P>
			</div>
		</section>
	</Container>

	<Footer slot='footer' />
</PageLayout>
