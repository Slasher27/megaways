---
import BaseLayout from './../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import H1 from '../components/typography/H1.astro';
import H2 from '../components/typography/H2.astro';
import H3 from '../components/typography/H3.astro';
import H4 from '../components/typography/H4.astro';
import H5 from '../components/typography/H5.astro';
import H6 from '../components/typography/H6.astro';
import P from '../components/typography/P.astro';
const metadata = {
	title: 'Megaways Home',
	description: 'The home of Megaways Slot Demos and Information',
};
interface Props {
	title: string;
}
---

<BaseLayout title={metadata.title} description={metadata.description}
	><Container
		><H1>Megaways Home</H1>
		<Button variant='primary' size='sm'>Button</Button>
		<Button variant='secondary' size='md'>Button</Button>
		<Button variant='ghost' size='lg'>Button</Button>
		<H2>Heading 2</H2>
		<H3>Heading 3</H3>
		<H4>Heading 4</H4>
		<H5>Heading 5</H5>
		<H6>Heading 6</H6>
		<P size='sm' variant='small'> Small Body Text</P>
		<P size='md' variant='body'>Medium Body Text</P>
		<P size='lg' variant='lead'>Large Lead Text</P>
	</Container>
</BaseLayout>
