---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/layout/Container.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import H1 from '../../components/typography/H1.astro';
import CtaCard from '../../components/ui/CtaCard.astro';

const mechanic = await getEntry('mechanics', 'megaquads');

if (!mechanic) {
	throw new Error('Megaquads mechanic content not found');
}

const { Content } = await render(mechanic);

const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Megaquads', href: '/megaquads/' },
];

const pageTitle = `${mechanic.data.name} Slots ${new Date().getFullYear()} | How It Works & Best Games`;
const pageDescription = mechanic.data.description || `Learn about ${mechanic.data.name} slot mechanic, how it works, and the best games to play.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<BreadcrumbSchema items={breadcrumbItems} />
	<div class="flex min-h-screen flex-col">
		<Header />

		<main class="flex-1">
			<Container>
				<Breadcrumb items={breadcrumbItems} class="mb-6" />

				<header class="mb-8">
					<H1>{mechanic.data.name} Slots</H1>

					<div class="flex flex-wrap gap-4 items-center text-sm text-gray-600 dark:text-gray-400 mb-6">
						{mechanic.data.developer && (
							<div>
								<strong>Developer:</strong> {mechanic.data.developer}
							</div>
						)}
						{mechanic.data.yearIntroduced && (
							<div>
								<strong>Released:</strong> {mechanic.data.yearIntroduced}
							</div>
						)}
					</div>

				</header>

				<article class="review-prose prose prose-lg dark:prose-invert mb-8">
					<Content />
				</article>

				<CtaCard
					heading={`Browse All ${mechanic.data.name} Slots`}
					href='/online-slots/'
					label='View All Slots'
				>
					Discover our complete collection of {mechanic.data.name} slot reviews
					with detailed information on RTP, features, and where to play.
				</CtaCard>
			</Container>
		</main>

		<Footer />
	</div>
</BaseLayout>
