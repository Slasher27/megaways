---
// Dynamic route for casino reviews
// URL pattern: /online-casinos/[slug]-casino-review/
// Example: /online-casinos/fastpay-casino-review/

import { getCollection, render, type CollectionEntry, getEntry } from 'astro:content';
import CasinoReviewLayout from '../../layouts/CasinoReviewLayout.astro';
import H1 from '../../components/typography/H1.astro';
import H2 from '../../components/typography/H2.astro';
import H3 from '../../components/typography/H3.astro';
import P from '../../components/typography/P.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import { Image } from 'astro:assets';
import ProsCons from '../../components/reviews/ProsCons.astro';
import Tile from '../../components/ui/Tile.astro';
import TileGrid from '../../components/ui/TileGrid.astro';
import AuthorCard from '../../components/reviews/AuthorCard.astro';
import ReviewMeta from '../../components/reviews/ReviewMeta.astro';
import TocCard from '../../components/reviews/TocCard.astro';
import ActionBar from '../../components/layout/ActionBar.astro';
import VideoPlayer from '../../components/reviews/VideoPlayer.astro';
import VideoSchema from '../../components/seo/VideoSchema.astro';
import CasinoStatusBanner from '../../components/casino/CasinoStatusBanner.astro';
import ReviewChangeLog from '../../components/reviews/ReviewChangeLog.astro';
import CategoryScorecard from '../../components/casino/CategoryScorecard.astro';
import QuickVerdict from '../../components/casino/QuickVerdict.astro';
import VerifiedChip from '../../components/reviews/VerifiedChip.astro';
import Faq from '../../components/reviews/Faq.astro';
import SessionLog from '../../components/reviews/SessionLog.astro';
import Screenshot from '../../components/reviews/Screenshot.astro';
import Callout from '../../components/ui/Callout.astro';
import { paymentMethodMeta } from '../../data/payment-methods';

export async function getStaticPaths() {
	const casinos = await getCollection('casinos');

	return casinos.map((casino) => ({
		params: { slug: casino.data.slug },
		props: { casino },
	}));
}

interface Props {
	casino: CollectionEntry<'casinos'>;
}

const { casino } = Astro.props;

// Render content for the casino; h2 headings drive the two TOCs
const { Content, headings } = await render(casino);
const toc = headings.filter((heading) => heading.depth === 2);

// Get author details if available
const author = casino.data.author ? await getEntry(casino.data.author) : null;

// Status honesty (CASINO-REVIEW-PROTOCOL law 6): closed = zero CTAs.
const isClosed = casino.data.status === 'closed';

// Prepare video schema data if video exists
const hasVideo = !!casino.data.videoUrl;
const videoThumbnailUrl = casino.data.videoThumbnail
	? new URL(casino.data.videoThumbnail.src, Astro.site).href
	: casino.data.thumbnail
		? new URL(casino.data.thumbnail.src, Astro.site).href
		: '';
---

<CasinoReviewLayout casino={casino} headings={toc}>
	<!-- Video Schema Markup (if video exists) -->
	{hasVideo && casino.data.videoUrl && videoThumbnailUrl && (
		<VideoSchema
			name={`${casino.data.name} Review - 60 Second Summary`}
			description={`Quick 60-second video review of ${casino.data.name} covering bonuses, games, payment methods, and our expert verdict.`}
			thumbnailUrl={videoThumbnailUrl}
			uploadDate={casino.data.videoUploadDate || casino.data.publishedDate || new Date()}
			duration={casino.data.videoDuration || 60}
			embedUrl={casino.data.videoUrl}
			contentUrl={Astro.url.href}
		/>
	)}

	<!-- Status banner (warning/closed; renders nothing for live) -->
	<CasinoStatusBanner casino={casino.data} class='mb-8' />

	<!-- Title & Rating -->
	<header class='mb-8'>
		<H1 size='md' class='mb-4'>{casino.data.name} Review</H1>

		<div class='flex flex-wrap items-center gap-x-4 gap-y-2 mb-5'>
			<ReviewMeta
				rating={isClosed ? undefined : casino.data.rating}
				updatedDate={casino.data.updatedDate}
			/>
			<VerifiedChip verified={casino.data.verified} />
		</div>

		{
			casino.data.description && (
				<P
					variant='lead'
					size='lg'
					class='text-gray-600 dark:text-gray-400 mb-6'
				>
					{casino.data.description}
				</P>
			)
		}

		<!-- Badges -->
		<div class='flex flex-wrap gap-2'>
			{casino.data.featured && (
				<Badge variant='warning' size='md'>
					<Icon name='lucide:star' size={14} class='inline mr-1' />
					Featured
				</Badge>
			)}
			{casino.data.isNew && (
				<Badge variant='success' size='md'>
					<Icon name='lucide:sparkles' size={14} class='inline mr-1' />
					New
				</Badge>
			)}
			{casino.data.hasMegaways && (
				<Badge variant='primary' size='md'>
					<Icon name='lucide:zap' size={14} class='inline mr-1' />
					Megaways Slots
				</Badge>
			)}
			{casino.data.cryptoAccepted && (
				<Badge variant='secondary' size='md'>
					<Icon name='lucide:coins' size={14} class='inline mr-1' />
					Crypto Accepted
				</Badge>
			)}
		</div>
	</header>

	<!-- 60-Second Video Review (if available) -->
	{hasVideo && casino.data.videoUrl && (
		<section class="mb-8">
			<div class="mb-4 flex items-center gap-2">
				<Icon name="lucide:play-circle" size={24} class="text-primary-700 dark:text-primary-400" />
				<H2 size="md" class="mb-0">60-Second Video Review</H2>
			</div>
			<VideoPlayer
				videoUrl={casino.data.videoUrl}
				title={`${casino.data.name} Review - 60 Second Summary`}
			/>
			<P class="mt-3 text-sm text-gray-600 dark:text-gray-400 text-center">
				Quick overview of {casino.data.name} - Watch our 60-second expert review
			</P>
		</section>
	)}

	<!-- Welcome Bonus CTA Section (never on a closed casino) -->
	{
		!isClosed && casino.data.welcomeBonus && (
			<Card variant='bonus' padding='none' class='mb-8 overflow-hidden'>
				{/* One padded container (equal padding on all four sides) holding two
				    equal-width, equal-height columns. Grid items stretch by default, so
				    both columns are literally the same height; each centres its own
				    content vertically, keeping any residual whitespace small + symmetric. */}
				{/* Image column is deliberately wider than the text column: the image
				    height is width/2.09, so a wider column brings it closer to the text
				    height and shrinks the leftover whitespace either side of it. */}
				<div class='p-5 sm:p-6 lg:p-8 grid gap-5 sm:gap-6 lg:gap-8 md:grid-cols-[1.25fr_1fr] lg:grid-cols-[1.3fr_1fr]'>
					<!-- Screenshot: uncropped at its natural 470x225 ratio, centred in its column -->
					{
						(casino.data.thumbnail || casino.data.logo) && (
							<div class='flex items-center'>
								{casino.data.thumbnail ? (
									<Image
										src={casino.data.thumbnail}
										alt={`${casino.data.name} welcome offer screen`}
										width={470}
										height={225}
										class='w-full h-auto rounded-lg'
										loading='eager'
									/>
								) : casino.data.logo ? (
									<div class='w-full bg-gray-100 dark:bg-gray-800/60 rounded-lg aspect-47/23 flex items-center justify-center p-8'>
										<Image
											src={casino.data.logo}
											alt={`${casino.data.name} logo`}
											width={200}
											height={100}
											class='max-h-24 w-auto object-contain'
											loading='eager'
										/>
									</div>
								) : null}
							</div>
						)
					}

					{/* One left edge for every element in this column — the old icon-beside-text
					    block indented the title/amount past the chips, button and disclosure. */}
					<div class='flex flex-col justify-center gap-4'>
						<div>
							<P class='flex items-center gap-2 text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-2'>
								<Icon
									name='lucide:gift'
									size={16}
									class='text-primary-700 dark:text-primary-400 shrink-0'
								/>
								{casino.data.welcomeBonus.title}
							</P>
							{/* 3xl only from lg: at md the column is ~316px and 3xl wraps badly. */}
							<P class='text-2xl lg:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-0 text-balance'>
								{casino.data.welcomeBonus.amount}
							</P>
						</div>

						<div class='flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-600 dark:text-gray-400'>
							{casino.data.welcomeBonus.wageringRequirement && (
								<span class='flex items-center gap-1.5'>
									<Icon name='lucide:repeat' size={14} class='shrink-0' />
									{casino.data.welcomeBonus.wageringRequirement}x wagering
								</span>
							)}
							{casino.data.welcomeBonus.minDeposit && (
								<span class='flex items-center gap-1.5'>
									<Icon name='lucide:coins' size={14} class='shrink-0' />
									Min deposit: €{casino.data.welcomeBonus.minDeposit}
								</span>
							)}
						</div>

						<div>
							<Button
								href={casino.data.affiliateLink}
								variant='primary'
								size='lg'
								affiliate={true}
								class='w-full sm:w-auto text-lg px-8 py-3.5'
								aria-describedby='bonus-disclosure'
							>
								Visit {casino.data.name}
							</Button>
							<P
								id='bonus-disclosure'
								class='text-xs text-gray-600 dark:text-gray-400 mt-2 mb-0'
							>
								18+. T&Cs apply. Gamble responsibly.
							</P>
						</div>
					</div>
				</div>
			</Card>
		)
	}

	<!-- Quick Stats Grid -->
	<div class='grid grid-cols-2 md:grid-cols-4 gap-4 mb-8'>
		{
			casino.data.licenses && casino.data.licenses.length > 0 && (
				<Card padding='sm' class='text-center'>
					<div class='flex items-center justify-center mb-2'>
						<Icon name='lucide:shield-check' size={24} class='text-green-700 dark:text-green-400' />
					</div>
					<P class='text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1'>License</P>
					<P class='text-sm font-semibold mb-0'>{casino.data.licenses[0]}</P>
				</Card>
			)
		}
		{
			casino.data.markets && casino.data.markets.length > 0 && (
				<Card padding='sm' class='text-center'>
					<div class='flex items-center justify-center mb-2'>
						<Icon name='lucide:globe' size={24} class='text-primary-700 dark:text-primary-400' />
					</div>
					<P class='text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1'>Markets</P>
					<P class='text-sm font-semibold capitalize mb-0'>
						{casino.data.markets.slice(0, 2).join(', ')}
					</P>
				</Card>
			)
		}
		{
			casino.data.providers && casino.data.providers.length > 0 && (
				<Card padding='sm' class='text-center'>
					<div class='flex items-center justify-center mb-2'>
						<Icon name='lucide:building-2' size={24} class='text-primary-700 dark:text-primary-400' />
					</div>
					<P class='text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1'>Providers</P>
					<P class='text-sm font-semibold mb-0'>{casino.data.providers.length}+ Games</P>
				</Card>
			)
		}
		{
			casino.data.paymentMethods && casino.data.paymentMethods.length > 0 && (
				<Card padding='sm' class='text-center'>
					<div class='flex items-center justify-center mb-2'>
						<Icon
							name='lucide:credit-card'
							size={24}
							class='text-primary-700 dark:text-primary-400'
						/>
					</div>
					<P class='text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-1'>Payments</P>
					<P class='text-sm font-semibold mb-0'>{casino.data.paymentMethods.length}+ Methods</P>
				</Card>
			)
		}
	</div>

	<!-- Pros & Cons -->
	{
		(casino.data.pros?.length > 0 || casino.data.cons?.length > 0) && (
			<div class='mb-8'>
				<ProsCons pros={casino.data.pros} cons={casino.data.cons} />
			</div>
		)
	}

	<!-- Payment Methods Section -->
	{
		casino.data.paymentMethods && casino.data.paymentMethods.length > 0 && (
			<section class='mb-6'>
				<H2 size='sm' class='mb-3'>
					Payment Methods
				</H2>
				<Card>
					<div class='grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2'>
						{casino.data.paymentMethods.map((method) => {
							const meta = paymentMethodMeta(method);
							return (
								<div class='flex items-center gap-2.5 rounded-xl bg-gray-100 dark:bg-gray-800/60 px-3 py-2.5 min-w-0'>
									<Icon
										name={meta.icon}
										size={18}
										class='text-primary-700 dark:text-primary-400 shrink-0'
										aria-hidden='true'
									/>
									<span class='text-sm font-medium text-gray-800 dark:text-gray-200 truncate'>
										{meta.label}
									</span>
								</div>
							);
						})}
					</div>
				</Card>
			</section>
		)
	}

	<!-- Game Providers Section -->
	{
		casino.data.providers && casino.data.providers.length > 0 && (
			<section class='mb-8'>
				<H2 size='sm' class='mb-3'>
					Game Providers
				</H2>
				<Card>
					<div class='flex flex-wrap gap-3'>
						{casino.data.providers.map((provider) => (
							<Badge variant='primary' size='md'>
								{provider.replace(/-/g, ' ')}
							</Badge>
						))}
					</div>
				</Card>
			</section>
		)
	}

	<!-- On this page (mobile/tablet; xl+ uses the sticky aside in the layout) -->
	<TocCard headings={toc} class='mb-8' />

	<!-- Review Content (protocol components injected — no MDX imports needed) -->
	<section class='review-prose prose prose-lg dark:prose-invert mb-8'>
		<Content
			components={{
				Tile,
				TileGrid,
				Callout,
				Faq,
				SessionLog,
				Screenshot,
				QuickVerdict,
				CategoryScorecard,
			}}
		/>
	</section>

	<!-- Author & Date Info -->
	{
		author && (
			<AuthorCard
				author={author}
				publishedDate={casino.data.publishedDate}
				updatedDate={casino.data.updatedDate}
				variant='full'
				class='mb-8'
			/>
		)
	}

	<!-- Review History (renders only when changelog entries exist) -->
	<ReviewChangeLog entries={casino.data.changelog} class='mb-8' />

	<!-- Final CTA (never on a closed casino) -->
	{!isClosed && (
	<Card as='section' class='mt-12 text-center'>
		<p class='text-[0.6875rem] font-bold uppercase tracking-wider text-primary-700 dark:text-primary-400 mb-2'>
			Ready to spin?
		</p>
		<H3 size='lg' class='mb-4'>Ready to Play at {casino.data.name}?</H3>
		<P class='mb-6 text-gray-700 dark:text-gray-300'>
			{
				casino.data.welcomeBonus
					? `Claim your ${casino.data.welcomeBonus.amount} and start playing today!`
					: 'Sign up now and start playing your favorite games!'
			}
		</P>
		<Button
			href={casino.data.affiliateLink}
			variant='primary'
			size='lg'
			affiliate={true}
			class='text-lg px-8 py-4'
		>
			Visit {casino.data.name}
		</Button>
		<P class='text-xs text-gray-600 dark:text-gray-400 mt-4'>
			18+. Terms and conditions apply. Please gamble responsibly.
		</P>
	</Card>
	)}

	<!-- Sticky mobile affiliate CTA (never on a closed casino) -->
	{
		!isClosed && casino.data.affiliateLink && (
			<ActionBar>
				<Button
					href={casino.data.affiliateLink}
					variant='primary'
					affiliate={true}
					class='flex-1 justify-center'
				>
					Visit {casino.data.name}
				</Button>
			</ActionBar>
		)
	}
</CasinoReviewLayout>
