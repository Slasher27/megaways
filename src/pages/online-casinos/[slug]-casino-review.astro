---
// Dynamic route for casino reviews
// URL pattern: /online-casinos/[slug]-casino-review/
// Example: /online-casinos/fastpay-casino-review/
// Layout = owner design handoff 2026-10-27 (docs/design/).

import { getCollection, render, type CollectionEntry, getEntry } from 'astro:content';
import CasinoReviewLayout from '../../layouts/CasinoReviewLayout.astro';
import P from '../../components/typography/P.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import StatGrid from '../../components/ui/StatGrid.astro';
import ProsCons from '../../components/reviews/ProsCons.astro';
import Tile from '../../components/ui/Tile.astro';
import TileGrid from '../../components/ui/TileGrid.astro';
import AuthorCard from '../../components/reviews/AuthorCard.astro';
import ReviewHero from '../../components/reviews/ReviewHero.astro';
import ScoreBars from '../../components/reviews/ScoreBars.astro';
import VerdictCard from '../../components/reviews/VerdictCard.astro';
import ActionBar from '../../components/layout/ActionBar.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import VideoPlayer from '../../components/reviews/VideoPlayer.astro';
import VideoSchema from '../../components/seo/VideoSchema.astro';
import CasinoStatusBanner from '../../components/casino/CasinoStatusBanner.astro';
import BonusCard from '../../components/casino/BonusCard.astro';
import ReviewChangeLog from '../../components/reviews/ReviewChangeLog.astro';
import Faq from '../../components/reviews/Faq.astro';
import SessionLog from '../../components/reviews/SessionLog.astro';
import Screenshot from '../../components/reviews/Screenshot.astro';
import Callout from '../../components/ui/Callout.astro';
import CasinoCardCompact from '../../components/casino/CasinoCardCompact.astro';
import PaymentCards from '../../components/casino/PaymentCards.astro';
import MegawaysLibrary from '../../components/casino/MegawaysLibrary.astro';
import Reputation from '../../components/casino/Reputation.astro';
import TrustCheck from '../../components/casino/TrustCheck.astro';
import FlagTable from '../../components/reviews/FlagTable.astro';
import { paymentMethodMeta } from '../../data/payment-methods';
import { casinoScore } from '../../data/scorecards';
import { eur, fmtDate, reviewToc } from '../../data/format';

export async function getStaticPaths() {
	const casinos = await getCollection('casinos');

	return casinos.map((casino) => ({
		params: { slug: casino.data.slug },
		props: { casino },
	}));
}

interface Props {
	casino: CollectionEntry<'casinos'>;
}

const { casino } = Astro.props;
const data = casino.data;

// Body H2s + the route's closing sections, numbered continuously.
const { Content, headings, remarkPluginFrontmatter } = await render(casino);

// FAQPage for markdown FAQ sections (protocol reviews emit theirs via <Faq>).
const bodyFaqs = data.faqs.length === 0 ? (remarkPluginFrontmatter.faqsFromBody ?? []) : [];
const { toc, num } = reviewToc(
	headings.filter((heading) => heading.depth === 2),
	{ prosCons: data.pros.length + data.cons.length > 0, verdictHeadline: data.verdict?.headline },
);

// Get author details if available
const author = data.author ? await getEntry(data.author) : null;

// Status honesty (CASINO-REVIEW-PROTOCOL law 6): closed = zero CTAs, no score.
const isClosed = data.status === 'closed';

// Law 2: a scored casino shows the category mean /10; an unscored (launch-era)
// review keeps its /5 rating, labelled as such, until it is scored.
const { score: heroScore, max: heroMax, scored } = casinoScore(data);

// Alternatives (§3.13): live casinos only, deepest counted Megaways library
// first, then score — links to OUR reviews, never affiliate CTAs.
const alternatives = (await getCollection('casinos'))
	.filter((c) => c.data.slug !== data.slug && c.data.status !== 'closed')
	.sort(
		(a, b) =>
			(b.data.megawaysCount ?? -1) - (a.data.megawaysCount ?? -1) ||
			(casinoScore(b.data).score ?? 0) / casinoScore(b.data).max - (casinoScore(a.data).score ?? 0) / casinoScore(a.data).max,
	)
	.slice(0, 3);

const readMinutes = Math.max(1, Math.round((casino.body ?? '').split(/\s+/).length / 230));
const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const licence = data.licenceDetails[0]?.authority ?? data.licenses.join(', ');
const counted = fmtDate(data.megawaysCountedDate);

// Prepare video schema data if video exists
const hasVideo = !!data.videoUrl;
const videoThumbnailUrl = data.videoThumbnail
	? new URL(data.videoThumbnail.src, Astro.site).href
	: data.thumbnail
		? new URL(data.thumbnail.src, Astro.site).href
		: '';

// Section-card look for the route-rendered sections below the body.
const sectionCard = 'p-5 md:p-7';
const sectionH2 = 'text-2xl md:text-[1.875rem] font-extrabold tracking-[-0.02em] text-gray-900 dark:text-gray-100 mb-4';
---

<CasinoReviewLayout casino={casino} headings={toc}>
	<!-- Status banner (warning/closed; renders nothing for live) -->
	<CasinoStatusBanner slot='hero' casino={data} />

	<ReviewHero
		slot='hero'
		type='casino'
		max={heroMax}
		title={`${data.name} Review`}
		logo={data.logo}
		mark={data.name.charAt(0)}
		lead={data.description}
		chips={[
			data.featured && !isClosed && { label: 'Featured', tone: 'solid' as const },
			data.hasMegaways && { label: 'Megaways slots', tone: 'tint' as const },
			data.cryptoAccepted && { label: 'Crypto accepted', tone: 'plain' as const },
			data.isNew && { label: 'New', tone: 'plain' as const },
		].filter((c) => !!c)}
		authorName={author?.data.name}
		updatedDate={data.updatedDate}
		readMinutes={readMinutes}
		verified={data.verified}
		score={heroScore}
		scoreNote={scored ? 'mean of 6 categories' : 'pending re-score'}
	>
		<!-- Quick facts beside the title: the first six the data has, in this priority -->
		<StatGrid
			slot='aside'
			surface='raised'
			cols={2}
			class='h-full auto-rows-fr'
			limit={6}
			items={[
				{ label: 'Licence', value: licence },
				{ label: 'Founded', value: data.founded },
				{ label: 'Megaways slots', value: data.megawaysCount && `${data.megawaysCount}${counted ? ` (counted ${counted})` : ''}` },
				{ label: 'Markets', value: data.markets.slice(0, 2).map(capitalise).join(', ') },
				{ label: 'Providers', value: data.providers.length > 0 && `${data.providers.length}+` },
				{ label: 'Payments', value: (data.payments.length || data.paymentMethods.length) > 0 && `${data.payments.length || data.paymentMethods.length} methods` },
				{ label: 'Min deposit', value: eur(data.welcomeBonus?.minDeposit) },
				{ label: 'Crypto', value: data.cryptoAccepted ? 'Accepted' : undefined },
				{ label: 'Owner', value: data.owner },
				{ label: 'Platform', value: data.platform },
				{ label: 'Games', value: data.gameCount },
				{ label: 'Min withdrawal', value: eur(data.minWithdrawal) },
				{ label: 'KYC', value: data.kyc },
				{ label: 'Sister brands', value: data.sisterBrands.join(', ') },
			]}
		/>
	</ReviewHero>

	<!-- Welcome offer (design: straight under the hero; none when closed) -->
	<BonusCard slot='hero' casino={data} />



	<!-- Video Schema Markup (if video exists) -->
	{hasVideo && data.videoUrl && videoThumbnailUrl && (
		<VideoSchema
			name={`${data.name} Review - 60 Second Summary`}
			description={`Quick 60-second video review of ${data.name} covering bonuses, games, payment methods, and our expert verdict.`}
			thumbnailUrl={videoThumbnailUrl}
			uploadDate={data.videoUploadDate || data.publishedDate || new Date()}
			duration={data.videoDuration || 60}
			embedUrl={data.videoUrl}
			contentUrl={Astro.url.href}
		/>
	)}

	<!-- 60-Second Video Review (if available) -->
	{hasVideo && data.videoUrl && (
		<Card as='section' padding='none' class={sectionCard}>
			<h2 class={sectionH2}>60-Second Video Review</h2>
			<VideoPlayer
				videoUrl={data.videoUrl}
				title={`${data.name} Review - 60 Second Summary`}
			/>
			<P class="mt-3 text-sm text-gray-600 dark:text-gray-400 text-center">
				Quick overview of {data.name} - Watch our 60-second expert review
			</P>
		</Card>
	)}

	<!-- Review body: every H2 section renders as its own card (rehypeSectionCards).
	     Protocol components injected — no MDX imports needed. -->
	<section class='review-prose prose prose-lg dark:prose-invert'>
		<Content
			components={{
				Tile,
				TileGrid,
				Callout,
				Faq,
				SessionLog,
				Screenshot,
				ScoreBars,
				FlagTable,
				PaymentCards,
				MegawaysLibrary,
				Reputation,
				TrustCheck,
			}}
		/>
	</section>

	<!-- Payment method tiles: only for reviews whose MDX doesn't carry PaymentCards yet -->
	{
		data.paymentMethods.length > 0 && !casino.body?.includes('<PaymentCards') && (
			<Card as='section' padding='none' class={sectionCard}>
				<h2 class={sectionH2}>Payment Methods</h2>
				<ul class='flex flex-wrap gap-2 m-0 p-0 list-none'>
					{data.paymentMethods.map((method) => {
						const meta = paymentMethodMeta(method);
						return (
							<li class='flex items-center gap-2 rounded-full bg-gray-100 dark:bg-gray-800 px-3.5 py-2 text-sm text-gray-800 dark:text-gray-200'>
								<Icon name={meta.icon} size={16} class='text-primary-700 dark:text-primary-500 shrink-0' />
								{meta.label}
							</li>
						);
					})}
				</ul>
			</Card>
		)
	}

	<!-- Game providers -->
	{
		data.providers.length > 0 && (
			<Card as='section' padding='none' class={sectionCard}>
				<h2 class={sectionH2}>Game Providers</h2>
				<ul class='flex flex-wrap gap-2 m-0 p-0 list-none'>
					{data.providers.map((provider) => (
						<li class='rounded-full bg-gray-100 dark:bg-gray-800 px-3.5 py-2 text-sm text-gray-800 dark:text-gray-200 capitalize'>
							{provider.replace(/-/g, ' ')}
						</li>
					))}
				</ul>
			</Card>
		)
	}

	<!-- Pros & Cons (numbered section) -->
	<ProsCons id='pros-and-cons' number={num('pros-and-cons')} pros={data.pros} cons={data.cons} />

	<!-- Our verdict (orange card) — CTA #2; none for a closed casino -->
	<VerdictCard
		id='our-verdict'
		number={num('our-verdict')}
		verdict={data.verdict}
		score={heroScore}
		max={heroMax}
		cta={!isClosed && data.affiliateLink
			? { label: data.welcomeBonus ? `Claim ${data.welcomeBonus.amount}` : `Visit ${data.name}`, href: data.affiliateLink, affiliate: true }
			: undefined}
	/>

	<!-- Author & Date Info -->
	{
		author && (
			<AuthorCard
				author={author}
				publishedDate={data.publishedDate}
				updatedDate={data.updatedDate}
				variant='full'
			/>
		)
	}

	<!-- Review History (renders only when changelog entries exist) -->
	<ReviewChangeLog entries={data.changelog} />

	<!-- Alternatives (automatic on every review; links to our reviews only) -->
	{
		alternatives.length > 0 && (
			<Card as='section' padding='none' class={sectionCard} aria-labelledby='alternatives-heading'>
				<h2 id='alternatives-heading' class={sectionH2}>
					{isClosed ? `Alternatives to ${data.name}` : 'Other casinos we\'ve reviewed'}
				</h2>
				<div class='grid sm:grid-cols-3 gap-2'>
					{alternatives.map((entry) => <CasinoCardCompact casinoEntry={entry} />)}
				</div>
			</Card>
		)
	}

	{bodyFaqs.length > 0 && <FAQSchema questions={bodyFaqs} />}

	<!-- Floating CTA pill (appears once the hero scrolls away; never when closed) -->
	{
		!isClosed && data.affiliateLink && (
			<ActionBar
				title={data.name}
				score={heroScore}
				summary={[data.welcomeBonus?.amount, data.welcomeBonus?.wageringRequirement && `${data.welcomeBonus.wageringRequirement}x wagering`].filter(Boolean).join(' · ')}
			>
				<Button href={data.affiliateLink} affiliate={true} class='font-extrabold min-h-11'>
					Visit
					<Icon name='lucide:arrow-right' size={18} />
				</Button>
			</ActionBar>
		)
	}
</CasinoReviewLayout>
