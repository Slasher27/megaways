---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/layout/Container.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import H1 from '../../components/typography/H1.astro';
import P from '../../components/typography/P.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import CasinoCard from '../../components/casino/CasinoCard.astro';

// Get all casinos from content collection
const allCasinos = await getCollection('casinos');

// Separate featured and regular casinos
const featuredCasinos = allCasinos.filter(c => c.data.featured);
const regularCasinos = allCasinos.filter(c => !c.data.featured);

// Sort both by rating (highest first), then by name
const sortCasinos = (casinos: typeof allCasinos) => casinos.sort((a, b) => {
	if (b.data.rating && a.data.rating) {
		return b.data.rating - a.data.rating;
	}
	return a.data.name.localeCompare(b.data.name);
});

const sortedFeatured = sortCasinos(featuredCasinos);
const sortedRegular = sortCasinos(regularCasinos);

const metadata = {
	title: 'Online Casino Reviews | Best Casinos for Megaways Slots',
	description:
		'Expert reviews of online casinos featuring Megaways slots. Compare bonuses, payment methods, and game selection. Find the best casino for you.',
};

// Build breadcrumb items
const breadcrumbItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Online Casinos', href: '/online-casinos/' },
];
---

<!-- Breadcrumb Schema for SEO -->
<BreadcrumbSchema items={breadcrumbItems} />

<PageLayout title={metadata.title} description={metadata.description}>
	<Header slot="header" />

	<Container>
		<!-- Breadcrumb Navigation -->
		<Breadcrumb items={breadcrumbItems} class="mb-6" />

		<div class="mb-12">
			<H1 size="lg">Online Casinos</H1>
			<P variant="lead" size="lg" class="mt-4">
				Find the best online casinos for Megaways slots. Expert reviews with detailed information on bonuses, payment methods, and game selection.
			</P>
		</div>

		<!-- All Casinos Grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
			{allCasinos.map(casino => (
				<CasinoCard casinoEntry={casino} />
			))}
		</div>

		<!-- Empty State -->
		{allCasinos.length === 0 && (
			<div class="text-center py-12">
				<P class="text-gray-500 dark:text-gray-400">
					No casinos found. Check back soon!
				</P>
			</div>
		)}
	</Container>

	<Footer slot="footer" />
</PageLayout>
